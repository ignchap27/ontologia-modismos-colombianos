<http://example.org/modcol/recurso/modismo/sobrado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Qué está comiendo? ¿Me va a dejar el sobrado?"@es .

<http://example.org/modcol/recurso/modismo/sobrado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
