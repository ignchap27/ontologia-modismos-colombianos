    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Chaqueta larga que compone este traje y se abrocha hasta el cuello."@es .

<http://example.org/modcol/recurso/modismo/liso/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "audaz, desvergonzado"@es .

<http://example.org/modcol/recurso/modismo/liso/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
