<http://example.org/modcol/recurso/modismo/tumbar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando los colonos llegamos ya otros habían tumbado y socolado: faltaba sólo la quema para tener lo que se llama una chagra."@es .

<http://example.org/modcol/recurso/modismo/tumbar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tumbar/acepcion/2/ejemplo> ;
