<http://example.org/modcol/recurso/modismo/bambaludo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, que es mayor de edad, pero que no es hábil para ningún trabajo."@es .

<http://example.org/modcol/recurso/modismo/bambazú/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bambazú/acepcion/1/ejemplo> ;
