<http://example.org/modcol/recurso/modismo/salón/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Todo el salón estuvo de acuerdo con el aplazamiento de la evaluación."@es .

<http://example.org/modcol/recurso/modismo/sampedrear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
