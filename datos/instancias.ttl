<http://example.org/modcol/recurso/modismo/pañalera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Las pañaleras suelen tener espacios internos amplios, ideales para cargar los artículos del bebé."@es .

<http://example.org/modcol/recurso/modismo/pañalera/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
