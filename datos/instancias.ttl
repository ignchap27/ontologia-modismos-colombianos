<http://example.org/modcol/recurso/modismo/cachicado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una cosa, deteriorada o roída."@es .

<http://example.org/modcol/recurso/modismo/cachicado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cachicado/acepcion/2/ejemplo> ;
    skos:definition "Referido al cabello, trasquilado o disparejo."@es .

<http://example.org/modcol/recurso/modismo/cachicado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Alguna vez no ha salido cachicado de la peluquería?"@es .

<http://example.org/modcol/recurso/modismo/cachicar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cachicar/acepcion/1/ejemplo> ;
