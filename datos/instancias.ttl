<http://example.org/modcol/recurso/modismo/salir-pitado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "salieron pitados para la casa"@es .

<http://example.org/modcol/recurso/modismo/salir/acepcion/1> a mc:Acepcion ;
