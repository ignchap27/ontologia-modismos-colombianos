<http://example.org/modcol/recurso/modismo/chanchiro/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "qué haremos, mi bien, qué haremos,/tan chanchirientos que estamos:/juntemos nuestros chanchiros/y un solo chanchiro hagamos"@es .

<http://example.org/modcol/recurso/modismo/chancho/acepcion/1> a mc:Acepcion ;
