<http://example.org/modcol/recurso/modismo/verraco/acepcion/4/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "-¡Maestro, usted es un verraco, sabe latín! Se va a ir a celebrar misa al cielo."@es .

<http://example.org/modcol/recurso/modismo/verraco/acepcion/5> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/verraco/acepcion/5/ejemplo> ;
