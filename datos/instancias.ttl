    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Chinche, insecto parásito de color rojo oscuro que chupa la sangre produciendo picaduras irritantes."@es .

<http://example.org/modcol/recurso/modismo/carantanta/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/carantanta/acepcion/1/ejemplo> ;
