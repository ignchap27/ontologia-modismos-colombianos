<http://example.org/modcol/recurso/modismo/bogadera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En Risaralda es común la denominada ‘bogadera’, refrescante bebida para la media mañana y media tarde que se da a los trabajadores."@es .

<http://example.org/modcol/recurso/modismo/bogar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
