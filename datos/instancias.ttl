<http://example.org/modcol/recurso/modismo/empelotado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Amase con fuerza, mijo! Ese barro está quedando todo empelotado y así no sirve para trabajarlo."@es .

<http://example.org/modcol/recurso/modismo/empelotar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empelotar/acepcion/1/ejemplo> ;
