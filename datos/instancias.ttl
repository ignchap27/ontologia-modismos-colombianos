<http://example.org/modcol/recurso/modismo/empelotar/acepcion/5> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empelotar/acepcion/5/ejemplo> ;
    skos:definition "Desnudar a una persona."@es .

<http://example.org/modcol/recurso/modismo/empelotar/acepcion/5/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si alguna vez me ven por la calle con una mujer como las que se empelotan en las revistas, puede ser que solo seamos amigos."@es .

<http://example.org/modcol/recurso/modismo/empeloto/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empeloto/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, desnuda."@es .

<http://example.org/modcol/recurso/modismo/empeloto/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La joven salió a las volandas envuelta en una toalla, pero la toalla se enredó en la falleba de la puerta y por eso la vieron correr empelota."@es .

<http://example.org/modcol/recurso/modismo/empepado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empepado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que está bajo los efectos de la droga o de tranquilizantes."@es .

<http://example.org/modcol/recurso/modismo/empepado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "\"Los punks de verdad no escuchamos música electrónica y no andamos empepados\"."@es .

<http://example.org/modcol/recurso/modismo/empeparse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empeparse/acepcion/1/ejemplo> ;
    skos:definition "Consumir tranquilizantes o estupefacientes en pastillas."@es .

<http://example.org/modcol/recurso/modismo/empeparse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Al principio vivía irritado, no podía dormir, por eso es que tengo que empeparme."@es .

<http://example.org/modcol/recurso/modismo/emperrarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/emperrarse/acepcion/1/ejemplo> ;
    skos:definition "Entrar en un llanto desbordado."@es .

<http://example.org/modcol/recurso/modismo/emperrarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Válgame Dios, señor cura, pero si se emperró, lo mismo que un chiquito."@es .

<http://example.org/modcol/recurso/modismo/emperrarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Enfurecerse."@es .

<http://example.org/modcol/recurso/modismo/empila/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empila/acepcion/1/ejemplo> ;
    skos:definition "Mucho, en gran cantidad."@es .

<http://example.org/modcol/recurso/modismo/empila/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Anoche comimos empila."@es .

<http://example.org/modcol/recurso/modismo/empiyamar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empiyamar/acepcion/1/ejemplo> ;
    skos:definition "Poner la piyama."@es .

<http://example.org/modcol/recurso/modismo/empiyamar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se las ingenió para quitarse el uniforme y empiyamarse más temprano."@es .

<http://example.org/modcol/recurso/modismo/empiñatado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empiñatado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, emocionada o entusiasmada con algo."@es .

<http://example.org/modcol/recurso/modismo/empiñatado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Juliana está empiñatada con su nuevo perro, nunca había tenido uno,"@es .

<http://example.org/modcol/recurso/modismo/emplayar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/emplayar/acepcion/1/ejemplo> ;
    skos:definition "Añadir demasiada fariña a un caldo."@es .

<http://example.org/modcol/recurso/modismo/emplayar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El caldo de ají estaba sabroso, pero del gusto de volver a los sabores tradicionales se me fue la mano en la fariña y me emplayé."@es .

<http://example.org/modcol/recurso/modismo/emplayar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/emplayar/acepcion/2/ejemplo> ;
    skos:definition "Inmovilizar una embarcación en la arena o en algún obstáculo de un cauce o en sus orillas."@es .

<http://example.org/modcol/recurso/modismo/emplayar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los sujetos, emplayaron la embarcación y corrieron hacia los esteros del sector conocido como Bocas de los Mangos."@es .

<http://example.org/modcol/recurso/modismo/empozarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "aposentarse el agua, quedar detenida en un sitio, formando un charco o pozo"@es .

<http://example.org/modcol/recurso/modismo/emproblemado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/emproblemado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que tiene muchos problemas."@es .

<http://example.org/modcol/recurso/modismo/emproblemado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Hasta hace pocos meses era un hombre menos conocido, pero menos emproblemado también."@es .

<http://example.org/modcol/recurso/modismo/empuercar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empuercar/acepcion/1/ejemplo> ;
    skos:definition "Ensuciar o llenar de basura."@es .

<http://example.org/modcol/recurso/modismo/empuercar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si el agua del charco está limpia, ¿Para qué empuercarla removiendo el lodo del fondo?"@es .

<http://example.org/modcol/recurso/modismo/empujada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empujada/acepcion/1/ejemplo> ;
    skos:definition "Empujón que se da con más fuerza."@es .

<http://example.org/modcol/recurso/modismo/empujada/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El jugador hacía un gran partido, pero lo matizó con una empujada infantil sobre el delantero."@es .

<http://example.org/modcol/recurso/modismo/empujarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empujarse/acepcion/1/ejemplo> ;
    skos:definition "Beber algo de golpe, especialmente una copa de licor."@es .

<http://example.org/modcol/recurso/modismo/empujarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se empujó el último trago para irse pronto de la fiesta."@es .

<http://example.org/modcol/recurso/modismo/empuje/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empuje/acepcion/1/ejemplo> ;
    skos:definition "Con emprendimiento y osadía."@es .

<http://example.org/modcol/recurso/modismo/empuje/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Su historia es el ejemplo de una empresa de empuje, que creció con el esfuerzo y la unión de una familia con todos sus trabajadores."@es .

<http://example.org/modcol/recurso/modismo/empuntar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empuntar/acepcion/1/ejemplo> ;
    skos:definition "Animar a alguien a hacer algo."@es .

<http://example.org/modcol/recurso/modismo/empuntar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Voy a empuntar los muchachos para que lleguen temprano."@es .

<http://example.org/modcol/recurso/modismo/empuntar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empuntar/acepcion/2/ejemplo> ;
    skos:definition "Dirigir algo hacia algún lugar."@es .

<http://example.org/modcol/recurso/modismo/empuntar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Otra ventaja que trae la Feria a los comerciantes es que pueden comparar sus productos y empuntar sus estrategias en ventas para ser más productivos."@es .

<http://example.org/modcol/recurso/modismo/emputar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
