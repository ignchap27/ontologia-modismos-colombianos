<http://example.org/modcol/recurso/modismo/balcón/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El debate entre los candidatos está como para alquilar balcón."@es .

<http://example.org/modcol/recurso/modismo/baldado/acepcion/1> a mc:Acepcion ;
