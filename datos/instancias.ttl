<http://example.org/modcol/recurso/modismo/embucharse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me embuché por tomar tanta gaseosa."@es .

<http://example.org/modcol/recurso/modismo/emburundangar/acepcion/1> a mc:Acepcion ;
