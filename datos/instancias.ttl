    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sudor/acepcion/1/ejemplo> ;
    skos:definition "medicamento que hace sudar"@es .

<http://example.org/modcol/recurso/modismo/sudor/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "me tomé un sudor, para esta gripa"@es .

<http://example.org/modcol/recurso/modismo/suelazo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/suelazo/acepcion/1/ejemplo> ;
    skos:definition "Golpe muy fuerte que sufre una persona al caerse o chocarse contra algo."@es .

<http://example.org/modcol/recurso/modismo/suelazo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se enredó con los cordones y se dio un suelazo."@es .

<http://example.org/modcol/recurso/modismo/suero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/suero/acepcion/1/ejemplo> ;
    skos:definition "Crema de leche ácida de textura suave y aromática que se emplea para acompañar cualquier comida."@es .

<http://example.org/modcol/recurso/modismo/suero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No hay como degustar en este calorcito de Montería una viuda de bocachico, acompañado de una yuca harinosa, plátano amarillo y verde, suero atoyabuey."@es .

<http://example.org/modcol/recurso/modismo/suero/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/suero/acepcion/2/ejemplo> ;
    skos:definition "Queso blando y graso de consistencia cremosa elaborado principalmente con leche entera."@es .

<http://example.org/modcol/recurso/modismo/suero/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ingredientes para preparar maduritos tibios con suero costeño y pimienta verde."@es .

<http://example.org/modcol/recurso/modismo/sueñera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sueñera/acepcion/1/ejemplo> ;
    skos:definition "Somnolencia, pesadez."@es .

<http://example.org/modcol/recurso/modismo/sueñera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Después del almuerzo, en tierra caliente, te coge una sueñera que te pone a dormir en hamaca."@es .

<http://example.org/modcol/recurso/modismo/sufridera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sufridera/acepcion/1/ejemplo> ;
    skos:definition "Sufrimiento frecuente."@es .

<http://example.org/modcol/recurso/modismo/sufridera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Qué sufridera con ese partido, casi no clasificamos por ese autogol."@es .

<http://example.org/modcol/recurso/modismo/sufrido/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sufrido/acepcion/1/ejemplo> ;
    skos:definition "Referido a algo, que cuesta mucho esfuerzo obtenerlo."@es .

<http://example.org/modcol/recurso/modismo/sufrido/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Después de tres pruebas y dos entrevistas conseguí el trabajo. ¡Qué puesto tan sufrido!"@es .

<http://example.org/modcol/recurso/modismo/suiche/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Subteniente o un recluta que se acaba de incorporar al ejército."@es .

<http://example.org/modcol/recurso/modismo/sumercé/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "forma de tratamiento empleada como expresión cariñosa y respetuosa, especialmente con la familia"@es .

<http://example.org/modcol/recurso/modismo/sumercé/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sumercé/acepcion/2/ejemplo> ;
    skos:definition "Forma de tratamiento, segunda persona del singular, que expresa respeto y afecto."@es .

<http://example.org/modcol/recurso/modismo/sumercé/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿A sumercé le provoca un tinto?"@es .

<http://example.org/modcol/recurso/modismo/sumir/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sumir/acepcion/1/ejemplo> ;
    skos:definition "Hundir una superficie al golpearla o apretarla."@es .

<http://example.org/modcol/recurso/modismo/sumir/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con el golpe sumieron una de las puertas del carro."@es .

<http://example.org/modcol/recurso/modismo/sungo-ga/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, lampiño."@es .

<http://example.org/modcol/recurso/modismo/sungo-ga/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, con piel brillante y cabello muy rizado por su larga exposición al ambiente."@es .

<http://example.org/modcol/recurso/modismo/sungo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sungo/acepcion/1/ejemplo> ;
    skos:definition "Vísceras de un animal."@es .

<http://example.org/modcol/recurso/modismo/sungo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El cuy es un roedor que se asa y se come acompañado de papas, ají de maní, sungos, rosas o crispetas y aguardiente Nariño."@es .

<http://example.org/modcol/recurso/modismo/suplirse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "recibir algún provecho o beneficio. promesas y más promesas/que nunca las has cumplido,/si me quisieras de veras/di algo me hubiera suplido"@es .

<http://example.org/modcol/recurso/modismo/surco/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/surco/acepcion/1/ejemplo> ;
    skos:definition "tierra que levanta el arado entre una y otra hendedura"@es .

<http://example.org/modcol/recurso/modismo/surco/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "levante más el surco para que no se pudra la papa"@es .

<http://example.org/modcol/recurso/modismo/surco/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Pequeña montaña de tierra que queda a cada lado de la hendidura del arado."@es .

<http://example.org/modcol/recurso/modismo/surquear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "entre aparceros, sacar los frutos de los surcos"@es .

<http://example.org/modcol/recurso/modismo/surquear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "hacer surcos en la tierra al ararla"@es .

<http://example.org/modcol/recurso/modismo/surrungiar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/surrungiar/acepcion/1/ejemplo> ;
    skos:definition "Tocar un instrumento como un aficionado."@es .

<http://example.org/modcol/recurso/modismo/surrungiar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Nunca olvidaré la canción \"Madre querida\", interpretada por aquel par de músicos campesinos, pero especialmente por aquella peinillita azul cielo, con la que uno de ellos surrunguiaba la guitarra."@es .

<http://example.org/modcol/recurso/modismo/surullo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/surullo/acepcion/1/ejemplo> ;
    skos:definition "Rollo que se forma con un papel, tela, etc."@es .

<http://example.org/modcol/recurso/modismo/surullo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Una vez hecho el ritual, cogería la toalla y haría un surullo envolvente y arabesco para encerrar su cabello y dejarlo ahí mientras se acabara de vestir."@es .

<http://example.org/modcol/recurso/modismo/surumba/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/surumba/acepcion/1/ejemplo> ;
    skos:definition "Agua de panela con limón."@es .

<http://example.org/modcol/recurso/modismo/surumba/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ese es un tolimense de pura cepa, criado con tamal y surumba bien fría."@es .

<http://example.org/modcol/recurso/modismo/surumba/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "huila, tol. agua de panela"@es .

<http://example.org/modcol/recurso/modismo/suspenso/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Género literario o cinematográfico que se caracteriza por mantener a lo largo de la obra la expectativa o la tensión."@es .

<http://example.org/modcol/recurso/modismo/suspenso/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Emoción o misterio causado por el desconocimiento en el desarrollo de una acción."@es .

<http://example.org/modcol/recurso/modismo/suspiro/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/suspiro/acepcion/1/ejemplo> ;
    skos:definition "Dulce elaborado con clara de huevo batida y azúcar."@es .

<http://example.org/modcol/recurso/modismo/suspiro/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Esta vez, vamos a hacer merenguitos o también llamados merengues o suspiros."@es .

<http://example.org/modcol/recurso/modismo/susunga/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "utensilio que se emplea para sacar el agua o la cachaza en los trapiches"@es .

<http://example.org/modcol/recurso/modismo/sute/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sute/acepcion/1/ejemplo> ;
    skos:definition "Niño flaco y desnutrido."@es .

<http://example.org/modcol/recurso/modismo/sute/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El patrón sí quería otro empleado y que ojalá les saliera más fuerte y grande, porque el que le habían presentado estaba muy sute y no tenía facha de servir para el trabajo."@es .

<http://example.org/modcol/recurso/modismo/sute/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Hijo menor."@es .

<http://example.org/modcol/recurso/modismo/sute/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, de poca estatura."@es .

<http://example.org/modcol/recurso/modismo/sánduche/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Lo que tiene forma parecida a este alimento."@es .

<http://example.org/modcol/recurso/modismo/sánduche/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sánduche/acepcion/2/ejemplo> ;
    skos:definition "Comida consistente en dos rebanadas de pan, rellenas con algún alimento."@es .

<http://example.org/modcol/recurso/modismo/sánduche/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En mi lonchera siempre había un sánduche de jamón y queso y un jugo de mango."@es .

<http://example.org/modcol/recurso/modismo/súpito/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/súpito/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, perpleja o atónita por una sorpresa."@es .

<http://example.org/modcol/recurso/modismo/súpito/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Alguien me dijo la última Semana Santa había sido fatal para la literatura universal porque en dos días habían muerto Mario Rivero y Corín Tellado. Quedé súpito."@es .

<http://example.org/modcol/recurso/modismo/tabaquero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tabaquero/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que practica la brujería por medio de la lectura del tabaco para efectos de adivinación y atracción de la persona amada."@es .

<http://example.org/modcol/recurso/modismo/tabaquero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Lectura del tabaco, tarot experta tabaquera atrae y amarra al ser querido sin causar daño."@es .

<http://example.org/modcol/recurso/modismo/tabla-burra/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tabla-burra/acepcion/1/ejemplo> ;
    skos:definition "Tabla ancha de diversas maderas y medidas utilizada en construcción."@es .

<http://example.org/modcol/recurso/modismo/tabla-burra/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se ponen tablas burra de madera ordinaria predimensionadas de acuerdo con los niveles o alturas especificadas en los planos."@es .

<http://example.org/modcol/recurso/modismo/tableado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "abundante, por ejemplo, comida"@es .

<http://example.org/modcol/recurso/modismo/tablúo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tablúo/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona o a una cosa, de gran tamaño, enorme."@es .

<http://example.org/modcol/recurso/modismo/tablúo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La amiga de mi mamá siempre ha vivido en el edificio ese tablúo, que se llama Mainero."@es .

<http://example.org/modcol/recurso/modismo/tacacho/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Plátano en puré o machacado hecho en potaje."@es .

<http://example.org/modcol/recurso/modismo/tacacho/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tacacho/acepcion/2/ejemplo> ;
    skos:definition "Fritura hecha con masa de plátano verde, rellena de chicharrón y aliños."@es .

<http://example.org/modcol/recurso/modismo/tacacho/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El tacacho es uno de los platos típicos del Putumayo. Es una bola de puré pero de plátano que acompaña carnes, aves y otros."@es .

<http://example.org/modcol/recurso/modismo/tacada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tacada/acepcion/1/ejemplo> ;
    skos:definition "Gran cantidad."@es .

<http://example.org/modcol/recurso/modismo/tacada/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Habrá una tacada de visitantes ilustres para las próximas fechas."@es .

<http://example.org/modcol/recurso/modismo/tacado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tacado/acepcion/1/ejemplo> ;
    skos:definition "Sopa que se prepara con guineo, cualquier tipo de carne y tubérculos."@es .

<http://example.org/modcol/recurso/modismo/tacado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tienen, también, platos como el tacado de guineo con espinazo y dulce cortado, que deleitan a quienes visitan este bello Municipio."@es .

<http://example.org/modcol/recurso/modismo/tacado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Plátano en puré o machacado hecho en potaje."@es .

<http://example.org/modcol/recurso/modismo/tacar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tacar/acepcion/1/ejemplo> ;
    skos:definition "En billar, golpear la bola con el taco."@es .

<http://example.org/modcol/recurso/modismo/tacar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Una de las actividades que se practican en las modalidades de carambola libre, tres bandas y pool, es la de tacar con cualquier bola y en cualquier dirección."@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/taco/acepcion/1/ejemplo> ;
    skos:definition "Mecanismo destinado a interrumpir o restablecer la corriente eléctrica de sectores específicos de la instalación eléctrica de una edificación."@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si se presenta un corte de luz en las áreas comunes, el vigilante deberá bajar los tacos que correspondan a esta área y comunicar de inmediato a la portería."@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "En un zapato, capa de suela que se pone en la parte inferior del tacón."@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Pieza cilíndrica que contiene una carga explosiva que se emplea generalmente para voladuras."@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "trancón, embotellamiento de tránsito"@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/5> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/taco/acepcion/5/ejemplo> ;
    skos:definition "Congestión en la circulación de vehículos en las vías públicas."@es .

<http://example.org/modcol/recurso/modismo/taco/acepcion/5/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El caos comienza precisamente en la calle cincuenta y los tacos pueden superar las dos horas desde Itagüí hasta Caldas."@es .

<http://example.org/modcol/recurso/modismo/tacón/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "El que es largo y tiene forma de puntilla."@es .

<http://example.org/modcol/recurso/modismo/taita/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/taita/acepcion/1/ejemplo> ;
    skos:definition "Papá."@es .

<http://example.org/modcol/recurso/modismo/taita/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Mamá negra era un trozo de cosa dura, untada de risa por fuera. Mi taita dijo que cuando muriera iba a hacer una canoa con ella."@es .

<http://example.org/modcol/recurso/modismo/taita/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/taita/acepcion/2/ejemplo> ;
    skos:definition "Respecto de un hijo, padres."@es .

<http://example.org/modcol/recurso/modismo/taita/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Y sepa y entienda que estos mozos de ahora nos van a enseñar a los taitas a hacer los hijos."@es .

<http://example.org/modcol/recurso/modismo/tajada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tajada/acepcion/1/ejemplo> ;
    skos:definition "Ganancia que se obtiene a través de una repartición ventajosa o de una transacción dudosa."@es .

<http://example.org/modcol/recurso/modismo/tajada/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tentada por la tajada burocrática, y sin ningún rubor, cambió su voto y apoyó al otro candidato."@es .

<http://example.org/modcol/recurso/modismo/tajada/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Alimento elaborado con rebanadas de plátano maduro frito."@es .

<http://example.org/modcol/recurso/modismo/tal/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/tal/acepcion/1/ejemplo> ;
    skos:definition "Expresa asombro ante la posibilidad, planteada por otro, de que ocurra algo adverso o desagradable."@es .

<http://example.org/modcol/recurso/modismo/tal/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "De verdad crees que esto no va a ser un espantaflojos sino un veradero aguacero: ¿qué tal?"@es .

<http://example.org/modcol/recurso/modismo/talambuque/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/talambuque/acepcion/1/ejemplo> ;
    skos:definition "En alfarería, vasija plástica empleada en para almacenar o transportar agua u objetos utilizados en el manejo del barro."@es .

<http://example.org/modcol/recurso/modismo/talambuque/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Présteme el talambuque con con un poco de agua que la masa se me está secando."@es .

<http://example.org/modcol/recurso/modismo/talanquera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Puerta de esta cerca."@es .

<http://example.org/modcol/recurso/modismo/talanquera/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/talanquera/acepcion/2/ejemplo> ;
    skos:definition "Obstáculo, dificultad."@es .

<http://example.org/modcol/recurso/modismo/talanquera/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El secreto bancario, que parecía inexpugnable, se había convertido en una talanquera contra la que se estrellaban las investigaciones mejor intencionadas."@es .

<http://example.org/modcol/recurso/modismo/talanquera/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/talanquera/acepcion/3/ejemplo> ;
    skos:definition "Mecanismo con una vara metálica o de otro material, que se eleva o desciende sobre una vía o en la entrada de una edificación para controlar el paso de los vehículos."@es .

<http://example.org/modcol/recurso/modismo/talanquera/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Como el vigilante del edificio me conoce, tan pronto ve el carro, sube la talanquera de la entrada y entro sin tener que parar."@es .

<http://example.org/modcol/recurso/modismo/talanquera/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Cerca rústica hecha de cañas o palos entretejidos."@es .

<http://example.org/modcol/recurso/modismo/talego/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/talego/acepcion/1/ejemplo> ;
    skos:definition "Bolsa de plástico u otro material que se usa para llevar o guardar cosas."@es .

<http://example.org/modcol/recurso/modismo/talego/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pero de pronto se devolvió para meter en una talega la ropa que Silvestre ese día se había cambiado."@es .

<http://example.org/modcol/recurso/modismo/tallar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Producir escoriación, principalmente en la mano."@es .

<http://example.org/modcol/recurso/modismo/tallar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "dicho especialmente del calzado, apretar"@es .

<http://example.org/modcol/recurso/modismo/tallar/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "producir excoriaciones, raspaduras un lazo o una cuerda"@es .

<http://example.org/modcol/recurso/modismo/tallar/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
