<http://example.org/modcol/recurso/modismo/lempo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Es una maravilla! encontrarse con lempo de finca ¿o no?"@es .

<http://example.org/modcol/recurso/modismo/lengua/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
