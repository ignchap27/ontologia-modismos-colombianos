    skos:definition "Sobrevivir una persona a una situación peligrosa o riesgosa."@es .

<http://example.org/modcol/recurso/modismo/estar-contando-el-cuento/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Fue algo terrible que no se puede definir y le da gracias a Dios que “pueda estar contando el cuento”."@es .

<http://example.org/modcol/recurso/modismo/estar-en-aulagas/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
