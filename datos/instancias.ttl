    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Romper la confianza y la lealtad intencionadamente de un amigo"@es .

<http://example.org/modcol/recurso/modismo/calcetear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
