    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a un lugar, poblado en abundancia."@es .

<http://example.org/modcol/recurso/modismo/sobresábana/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
