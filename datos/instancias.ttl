    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/papi/acepcion/1/ejemplo> ;
    skos:definition "Modo en que la novia o esposa llama a su pareja."@es .

<http://example.org/modcol/recurso/modismo/papi/acepcion/1/ejemplo> a mc:EjemploDeUso ;
