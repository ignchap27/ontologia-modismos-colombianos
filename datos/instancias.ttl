<http://example.org/modcol/recurso/modismo/pasado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Sin ser invitada recorrió toda la casa haciendo comentarios poco discretos, ¡qué pasada!"@es .

