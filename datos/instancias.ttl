<http://example.org/modcol/recurso/modismo/carretel/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Carretel de hilo."@es .

<http://example.org/modcol/recurso/modismo/carretilla/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
