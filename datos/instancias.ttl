<http://example.org/modcol/recurso/modismo/carrandanga/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Qué carrandanga de gente la que había en el festival!"@es .

<http://example.org/modcol/recurso/modismo/carranga/acepcion/1> a mc:Acepcion ;
