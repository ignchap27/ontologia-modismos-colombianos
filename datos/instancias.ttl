<http://example.org/modcol/recurso/modismo/octagenario/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El octagenario hombre del boxeo tiene todas las aristas para cargar de drama la novela."@es .

<http://example.org/modcol/recurso/modismo/oficialismo/acepcion/1> a mc:Acepcion ;
