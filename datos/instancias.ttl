<http://example.org/modcol/recurso/modismo/instalación/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los hogares, todos atienden la convocatoria para armar el pesebre y hacer el árbol, decoraciones a las que se suman metros y metros de instalaciones de luces multicolores."@es .

<http://example.org/modcol/recurso/modismo/instalación/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/instalación/acepcion/2/ejemplo> ;
