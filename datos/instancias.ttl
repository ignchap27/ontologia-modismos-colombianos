    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bala/acepcion/1/ejemplo> ;
    skos:definition "A disparos hechos con un arma de fuego."@es .

<http://example.org/modcol/recurso/modismo/bala/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Un comerciante y un amigo fueron atacados a bala."@es .

<http://example.org/modcol/recurso/modismo/bala/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bala/acepcion/2/ejemplo> ;
    skos:definition "Ser veloz."@es .

<http://example.org/modcol/recurso/modismo/bala/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ese pelado es una bala. Se va hasta el otro lado de la cancha y regresa en un segundo."@es .

<http://example.org/modcol/recurso/modismo/balaca/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balaca/acepcion/1/ejemplo> ;
    skos:definition "Cinta, generalmente elástica, que se usa para sujetar el pelo hacia atrás o como adorno."@es .

<http://example.org/modcol/recurso/modismo/balaca/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Mis hijas siguen siendo niñas [...] con sus trajecitos marineros y los cabellos rebeldes sujetos por la balaca de vivos matices."@es .

<http://example.org/modcol/recurso/modismo/balaca/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balaca/acepcion/2/ejemplo> ;
    skos:definition "cinta o tira con que se sujetan el pelo las mujeres"@es .

<http://example.org/modcol/recurso/modismo/balaca/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "anudada adelante sobre la carrera, en formidable lazo, llevaba una balaca azul"@es .

<http://example.org/modcol/recurso/modismo/balache/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balache/acepcion/1/ejemplo> ;
    skos:definition "Posibilidad de hacer algo, oportunidad."@es .

<http://example.org/modcol/recurso/modismo/balache/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El cantante barranquillero Dylan presenta su nuevo sencillo No hay balache, que traduce en el argot cartagenero “no hay oportunidad”."@es .

<http://example.org/modcol/recurso/modismo/balancear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balancear/acepcion/1/ejemplo> ;
    skos:definition "Equilibrar la rotación de las llantas de un vehículo."@es .

<http://example.org/modcol/recurso/modismo/balancear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Balanceé las llantas porque cambié un rin."@es .

<http://example.org/modcol/recurso/modismo/balanza/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balanza/acepcion/1/ejemplo> ;
    skos:definition "Juego de parques infantiles que consiste en una barra sujeta al suelo por un eje central, que permite subir y bajar alternativamente a quienes se sitúan en cada extremo para balancearse."@es .

<http://example.org/modcol/recurso/modismo/balanza/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La balanza favorece el sistema vestibular por la sensación de movimiento y la contracción muscular en las piernas."@es .

<http://example.org/modcol/recurso/modismo/balastro/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balastro/acepcion/1/ejemplo> ;
    skos:definition "Dispositivo eléctrico que regula el encendido de las luces fluorescentes."@es .

<http://example.org/modcol/recurso/modismo/balastro/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Existen muchas clases de balastros para atenuar la intensidad de la luz de lámparas fluorescentes."@es .

<http://example.org/modcol/recurso/modismo/balastro/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balastro/acepcion/2/ejemplo> ;
    skos:definition "Conjunto de verduras, hortalizas y granos con los que se preparan algunas sopas."@es .

<http://example.org/modcol/recurso/modismo/balastro/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Nos invitó a tomar un rico sancocho de pollo pero en el plato había más balastro que otra cosa."@es .

<http://example.org/modcol/recurso/modismo/balay/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balay/acepcion/1/ejemplo> ;
