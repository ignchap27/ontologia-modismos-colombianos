    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/chontear/acepcion/1/ejemplo> ;
    skos:definition "Intimidar y perseguir a alguien, amedrentar."@es .

<http://example.org/modcol/recurso/modismo/chontear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los destrozos de nuestros \"hinchas\" en la Arenosa fueron grandes y los \"chontearon\" como ellos mismos dicen."@es .

<http://example.org/modcol/recurso/modismo/chontiado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/chontiado/acepcion/1/ejemplo> ;
    skos:definition "Salir rápidamente de alguna parte."@es .

<http://example.org/modcol/recurso/modismo/chontiado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando se escuchó una explosión, todo el mundo salió chontiado porque creyó que la pólvora se había estallado antes de la celebración."@es .

<http://example.org/modcol/recurso/modismo/chontudo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/chontudo/acepcion/1/ejemplo> ;
