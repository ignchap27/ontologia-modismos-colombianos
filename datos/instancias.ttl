<http://example.org/modcol/recurso/modismo/rollo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rollo/acepcion/2/ejemplo> ;
