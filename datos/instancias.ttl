    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salidera/acepcion/1/ejemplo> ;
    skos:definition "Salida reiterada y frecuente de un lugar."@es .

<http://example.org/modcol/recurso/modismo/salidera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Niños: para evitar la salidera, vayan al baño antes de entrar a la clase."@es .

<http://example.org/modcol/recurso/modismo/salir-como-pepa-de-guama/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "salir rápidamente"@es .

<http://example.org/modcol/recurso/modismo/salir-como-un-tiro/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "salir velozmente"@es .

<http://example.org/modcol/recurso/modismo/salir-con-un-chorro-de-babas/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salir-con-un-chorro-de-babas/acepcion/1/ejemplo> ;
    skos:definition "No lograr el resultado esperado, decepcionar."@es .

<http://example.org/modcol/recurso/modismo/salir-con-un-chorro-de-babas/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con ese “pedigrí”, en su familia, a uno le daría vergüenza salir con un chorro de babas."@es .

<http://example.org/modcol/recurso/modismo/salir-pitado/acepcion/1> a mc:Acepcion ;
