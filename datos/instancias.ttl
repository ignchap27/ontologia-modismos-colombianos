<http://example.org/modcol/recurso/modismo/atembar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "se va volviendo un insulso, un pendejete, un indolente boquiabierto. será . que esta tierra nos va atembando"@es .

<http://example.org/modcol/recurso/modismo/atembarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Desanimarse o acobardarse."@es .

<http://example.org/modcol/recurso/modismo/atembarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
