    mc:textoEjemplo "Buenamente fui a verte, mejor me hubiera quedado en mi casa."@es .

<http://example.org/modcol/recurso/modismo/buenamoza/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/buenamoza/acepcion/1/ejemplo> ;
