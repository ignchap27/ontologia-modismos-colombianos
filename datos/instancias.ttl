<http://example.org/modcol/recurso/modismo/carreteable/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Las poblaciones pequeñas y más apartadas del departamento se comunican por carreteables y caminos de herradura, muchos de ellos son sólo transitables en los meses de verano."@es .

<http://example.org/modcol/recurso/modismo/carretel/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/carretel/acepcion/1/ejemplo> ;
