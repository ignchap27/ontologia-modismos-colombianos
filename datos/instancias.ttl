    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "latigazo"@es .

<http://example.org/modcol/recurso/modismo/fuete/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "látigo"@es .

<http://example.org/modcol/recurso/modismo/fuete/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/fuete/acepcion/2/ejemplo> ;
    skos:definition "Instrumento de castigo largo y delgado, elaborado con fibras de cuero, pita u otro material."@es .

<http://example.org/modcol/recurso/modismo/fuete/acepcion/2/ejemplo> a mc:EjemploDeUso ;
