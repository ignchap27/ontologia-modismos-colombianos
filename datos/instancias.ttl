<http://example.org/modcol/recurso/modismo/colgandejo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Véngase vestido normal pero con corbata y las mujeres con algún colgandejo en el pelo."@es .

<http://example.org/modcol/recurso/modismo/colgandejo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
