<http://example.org/modcol/recurso/modismo/chucha/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/chucha/acepcion/2/ejemplo> ;
