<http://example.org/modcol/recurso/modismo/encunetarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No se puede transitar con los vehículos pequeños ya que se corre el riesgo de encunetarse y quedar varados."@es .

<http://example.org/modcol/recurso/modismo/encurtido/acepcion/1> a mc:Acepcion ;
