    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/marañaco/acepcion/1/ejemplo> ;
    skos:definition "Dibujo garabateado o mal hecho."@es .

<http://example.org/modcol/recurso/modismo/marañaco/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Qué de arte puede tener destruir monumentos, espacios públicos, fachadas de edificios particulares o públicos con marañacos ininteligibles?"@es .

<http://example.org/modcol/recurso/modismo/marañita/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
