    skos:definition "Referido a una persona o algo, que es elegante."@es .

<http://example.org/modcol/recurso/modismo/elegantoso/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Y te fuiste con ella a un bar muy chévere y elegantoso."@es .

<http://example.org/modcol/recurso/modismo/eleno/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/eleno/acepcion/1/ejemplo> ;
