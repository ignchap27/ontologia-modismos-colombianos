    skos:definition "Techar una edificación con paja o con hojas de palma."@es .

<http://example.org/modcol/recurso/modismo/empalmar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empalmar/acepcion/2/ejemplo> ;
