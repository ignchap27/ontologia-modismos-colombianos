<http://example.org/modcol/recurso/modismo/marimbero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Como tantos habitantes del Pacífico, don Guillermo Ríos, alabado marimbero, también fue campesino."@es .

<http://example.org/modcol/recurso/modismo/marimbero/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/marimbero/acepcion/2/ejemplo> ;
