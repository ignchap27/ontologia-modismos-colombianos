    skos:definition "dicho de una persona o animal, receloso, mañoso, resabiado"@es .

<http://example.org/modcol/recurso/modismo/machiro/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "un caballo machiro"@es .

