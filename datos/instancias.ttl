    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "dulce de leche cuajada y hervida con panela"@es .

<http://example.org/modcol/recurso/modismo/bifamiliar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bifamiliar/acepcion/1/ejemplo> ;
