<http://example.org/modcol/recurso/modismo/copera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En el bar, cientos de hombres se reúnen para recordar a sus coperas, mujeres que no sólo les servían una copa de trago, sino que les hacían compañía."@es .

<http://example.org/modcol/recurso/modismo/copera/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "empleada que sirve a los clientes en bares y cafés"@es .

<http://example.org/modcol/recurso/modismo/copetón/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/copetón/acepcion/1/ejemplo> ;
