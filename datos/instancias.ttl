<http://example.org/modcol/recurso/modismo/instalación/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La iniciativa fue presentada ayer por el Minminas en la instalación de la Conferencia Internacional de Transporte Masivo."@es .

<http://example.org/modcol/recurso/modismo/instalación/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/instalación/acepcion/3/ejemplo> ;
