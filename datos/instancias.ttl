    skos:definition "Comida ligera que se toma entre el desayuno y el almuerzo."@es .

<http://example.org/modcol/recurso/modismo/onces/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/onces/acepcion/2/ejemplo> ;
