<http://example.org/modcol/recurso/modismo/onces/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "“Las onces” no se comen, se toman y si es con un grupo de amigas en alguno de los salones de té del centro de Bogotá, fundados a mediados del siglo XIX, mejor que mejor."@es .

<http://example.org/modcol/recurso/modismo/onces/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "corto refrigerio que se toma entre el almuerzo y la comida o, en algunos lugares, entre el desayuno y el almuerzo"@es .

<http://example.org/modcol/recurso/modismo/opa/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "voz para saludar o llamar la atención"@es .

<http://example.org/modcol/recurso/modismo/opcionado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/opcionado/acepcion/1/ejemplo> ;
