<http://example.org/modcol/recurso/modismo/payaso/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Agapito me señala quienes son los payasos y vemos que están apostando y ganando."@es .

<http://example.org/modcol/recurso/modismo/paz-y-salvo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
