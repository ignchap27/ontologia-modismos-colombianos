<http://example.org/modcol/recurso/modismo/chulear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "al gamín lo chulearon"@es .

<http://example.org/modcol/recurso/modismo/chulear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
