    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bullugo/acepcion/1/ejemplo> ;
    skos:definition "Cantidad de dinero que sobresale del bolsillo."@es .

<http://example.org/modcol/recurso/modismo/bullugo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
