    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "persona locuaz, habladora y en algunos casos chismosa"@es .

<http://example.org/modcol/recurso/modismo/convite/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
