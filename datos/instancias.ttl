    skos:definition "Burlarse de alguien."@es .

<http://example.org/modcol/recurso/modismo/burear/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Hay gente que burea a una persona con discapacidad, y lo quieren agredir o pegarle."@es .

<http://example.org/modcol/recurso/modismo/burletero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
