<http://example.org/modcol/recurso/modismo/guayabo/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "tengo guayabo de mi tierra"@es .

<http://example.org/modcol/recurso/modismo/guayabo/acepcion/3> a mc:Acepcion ;
