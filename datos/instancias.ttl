<http://example.org/modcol/recurso/modismo/carreteable/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/carreteable/acepcion/2/ejemplo> ;
