<http://example.org/modcol/recurso/modismo/enferma/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una mujer, que está embarazada."@es .

<http://example.org/modcol/recurso/modismo/enfiestarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enfiestarse/acepcion/1/ejemplo> ;
    skos:definition "Estar de baile y fiesta por largo rato."@es .

<http://example.org/modcol/recurso/modismo/enfiestarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se ha consolidado como uno de los lugares más atractivos para ‘enfiestarse’. Con más de 8.000 personas por noche, es uno de los puntos donde la rumba es más variada."@es .

<http://example.org/modcol/recurso/modismo/enflautar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enflautar/acepcion/1/ejemplo> ;
    skos:definition "Asignar a alguien una labor o responsabilidad desagradable o inoportuna."@es .

<http://example.org/modcol/recurso/modismo/enflautar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Es un jugador mediocre que necesita demasiado acompañamiento y casi nos lo enflautan por tercera vez."@es .

<http://example.org/modcol/recurso/modismo/enfogado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enfogado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que tiene elevada la temperatura, dolores articulares y agotamiento físico."@es .

<http://example.org/modcol/recurso/modismo/enfogado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me tocaba pasar ríos y como estaba enfogado y con la ropa mojada, los cambios de temperatura me produjeron calambres."@es .

<http://example.org/modcol/recurso/modismo/enfuertar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enfuertar/acepcion/1/ejemplo> ;
    skos:definition "fermentar un líquido"@es .

<http://example.org/modcol/recurso/modismo/enfuertar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "enfuertar guarapo"@es .

<http://example.org/modcol/recurso/modismo/enfurruscarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enfurruscarse/acepcion/1/ejemplo> ;
