<http://example.org/modcol/recurso/modismo/pilatuna/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cada vez que hace memoria y recuerda alguna pilatuna, sonríe. No puede evitarlo. Por más fuerte que haya sido el castigo, el instante de alegría prevalece."@es .

<http://example.org/modcol/recurso/modismo/pilo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/pilo/acepcion/1/ejemplo> ;
