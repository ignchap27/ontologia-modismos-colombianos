<http://example.org/modcol/recurso/modismo/cachumbo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cachumbo/acepcion/2/ejemplo> ;
