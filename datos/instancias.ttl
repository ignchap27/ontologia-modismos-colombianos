<http://example.org/modcol/recurso/modismo/caminador/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si decide montar al bebé en el caminador, hágalo en un sitio plano, sin subidas ni bajadas y donde la superficie no sea deslizante."@es .

<http://example.org/modcol/recurso/modismo/caminar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/caminar/acepcion/1/ejemplo> ;
