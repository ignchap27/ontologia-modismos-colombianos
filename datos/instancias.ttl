    skos:definition "persona que asiste a un evento sin ser invitado o sin pagar. il"@es .

<http://example.org/modcol/recurso/modismo/pato/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
