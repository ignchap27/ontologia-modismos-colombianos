<http://example.org/modcol/recurso/modismo/rodillijunto/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "que tiene las piernas torcidas, con las rodillas juntas"@es .

<http://example.org/modcol/recurso/modismo/roja/acepcion/1> a mc:Acepcion ;
