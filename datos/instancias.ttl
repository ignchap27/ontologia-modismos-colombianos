    skos:definition "estar retardado para alguna actividad"@es .

<http://example.org/modcol/recurso/modismo/estar-mal-del-chicle/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
