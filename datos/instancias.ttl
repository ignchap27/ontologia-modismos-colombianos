<http://example.org/modcol/recurso/modismo/burra/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En el trabajo de restauración, la familia aprende, comparte, investiga, se moviliza, y claro, restaura ‘burras’ (bicicletas) de manera conjunta."@es .

<http://example.org/modcol/recurso/modismo/burrero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
