<http://example.org/modcol/recurso/modismo/avemaría/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Avemaría Cantalicia! ¿esas cosas tan horribles si serán ciertas?"@es .

