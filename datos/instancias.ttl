    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/nuca/acepcion/1/ejemplo> ;
    skos:definition "Vigilar muy de cerca a alguien."@es .

<http://example.org/modcol/recurso/modismo/nuca/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Esto sienta un precedente para que quienes se sienten en total libertad para robar y corromper perciban que hay autoridades que les pueden respirar en la nuca."@es .

<http://example.org/modcol/recurso/modismo/nuche/acepcion/1> a mc:Acepcion ;
