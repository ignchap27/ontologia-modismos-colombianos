    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/berrinche/acepcion/2/ejemplo> ;
    skos:definition "Olor a orina fuerte y concentrada."@es .

<http://example.org/modcol/recurso/modismo/berrinche/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Quizá sólo fue mi impresión y olía a lo de siempre, a humo, a gasolina, a berrinche en algunos sectores, o a limpio y a recatado en otros."@es .

<http://example.org/modcol/recurso/modismo/berrinche/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/berrinche/acepcion/3/ejemplo> ;
    skos:definition "Rabieta fuerte pero pasajera, especialmente en los niños."@es .

<http://example.org/modcol/recurso/modismo/berrinche/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pero en casos especiales un berrinche dura solo 15 segundos. En este tiempo algunos pequeños que saben cómo manipular a sus padres dejan de respirar."@es .

<http://example.org/modcol/recurso/modismo/berrinchín/acepcion/1> a mc:Acepcion ;
