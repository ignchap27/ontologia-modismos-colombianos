<http://example.org/modcol/recurso/modismo/rancharse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "alojarse en un lugar, por lo general sin consentimiento de los dueños"@es .

<http://example.org/modcol/recurso/modismo/rancharse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
