    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/insolvente/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que no puede hacer algo bien, incapaz."@es .

<http://example.org/modcol/recurso/modismo/insolvente/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Lo echaron del trabajo por insolvente y grosero."@es .

<http://example.org/modcol/recurso/modismo/instalación/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/instalación/acepcion/1/ejemplo> ;
