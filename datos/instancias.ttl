<http://example.org/modcol/recurso/modismo/flauta/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Flautas para exhibir ropa sean jeans o camisetas, son fáciles de instalar y ahorra espacio."@es .

<http://example.org/modcol/recurso/modismo/flauta/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/flauta/acepcion/3/ejemplo> ;
