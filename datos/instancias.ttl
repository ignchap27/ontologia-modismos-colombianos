<http://example.org/modcol/recurso/modismo/mosquear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Ustedes pueden creer que Alejandra no pestañeó? Seguro que su corazón ni se mosqueó hasta que la serpiente se largó."@es .

<http://example.org/modcol/recurso/modismo/mosquear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
