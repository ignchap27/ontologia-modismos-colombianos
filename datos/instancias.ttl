    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "emborracharse"@es .

<http://example.org/modcol/recurso/modismo/raspachín/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/raspachín/acepcion/1/ejemplo> ;
    skos:definition "Persona que recoge hoja de coca parael procesamiento de droga."@es .

<http://example.org/modcol/recurso/modismo/raspachín/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Empacó maletas y se fue a probar suerte esta vez a Bolivia, ya no como raspachín o recolector de hojas de coca sino como trabajador en un laboratorio."@es .

<http://example.org/modcol/recurso/modismo/raspar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/raspar/acepcion/1/ejemplo> ;
    skos:definition "Quitar las hojas a la planta de la coca para empezar el procesamiento de la droga."@es .

<http://example.org/modcol/recurso/modismo/raspar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los juguetes y los libros de los que servimos para raspar coca son los machetes, los costales, los ácidos, la gasolina y el cemento"@es .

<http://example.org/modcol/recurso/modismo/rasquiña/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rasquiña/acepcion/1/ejemplo> ;
    skos:definition "Comezón que se siente en alguna parte del cuerpo."@es .

<http://example.org/modcol/recurso/modismo/rasquiña/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Almorzaron en Guamaral y Ramón empezó a sentir rasquiña en el cuello, una opresión en los pulmones; tanto que dejó la mitad de la ternera asada que había pedido."@es .

<http://example.org/modcol/recurso/modismo/rastrojear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rastrojear/acepcion/1/ejemplo> ;
    skos:definition "Tener relaciones sexuales a la intemperie."@es .

<http://example.org/modcol/recurso/modismo/rastrojear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Rastrojear en Holanda: ahora es legal tener sexo en los parques."@es .

<http://example.org/modcol/recurso/modismo/rastrojo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rastrojo/acepcion/1/ejemplo> ;
    skos:definition "Maleza que cubre un terreno abandonado."@es .

<http://example.org/modcol/recurso/modismo/rastrojo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Extrañado observa en el rastrojo una cosa peluda e inmóvil debajo de unos trebejos. Sobrecogido y curioso ante el hallazgo intentó tocarla."@es .

<http://example.org/modcol/recurso/modismo/rata/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "persona vil y despreciable"@es .

<http://example.org/modcol/recurso/modismo/rata/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "tasa de interés"@es .

