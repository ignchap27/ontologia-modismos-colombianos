    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/patrón/acepcion/1/ejemplo> ;
    skos:definition "Jefe de una organización ilícita, especialmente de droga."@es .

<http://example.org/modcol/recurso/modismo/patrón/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡“Patrón”, usted sabe que tenemos encima a los norteamericanos, a los ingleses y a los israelitas, con este aparato nos ubican en el acto!"@es .

<http://example.org/modcol/recurso/modismo/patuleco/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "que tiene las piernas torcidas"@es .

<http://example.org/modcol/recurso/modismo/patuleto/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "que tiene las piernas torcidas"@es .

<http://example.org/modcol/recurso/modismo/paturro/acepcion/1> a mc:Acepcion ;
