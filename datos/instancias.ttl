<http://example.org/modcol/recurso/modismo/contener/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Y esto qué contiene! había dejado la cocina límpia y ahora mira este reguero."@es .

<http://example.org/modcol/recurso/modismo/contentar/acepcion/1> a mc:Acepcion ;
