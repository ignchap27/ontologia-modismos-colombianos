    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/canal/acepcion/1/ejemplo> ;
    skos:definition "Buscar comida gratis en alguna parte o a costa de alguien."@es .

