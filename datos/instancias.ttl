<http://example.org/modcol/recurso/modismo/joropo/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Las primeras grabaciones colombianas de joropos ejecutadas con arpa, cuatro y maracas, fueron hechas por Luis Ariel Rey."@es .

<http://example.org/modcol/recurso/modismo/joropódromo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/joropódromo/acepcion/1/ejemplo> ;
