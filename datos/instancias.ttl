<http://example.org/modcol/recurso/modismo/mariapalito/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Las hembras de los mariapalitos tienen la capacidad de poner huevos y generar clones de sí mismas, sin la necesidad de aparearse con machos."@es .

<http://example.org/modcol/recurso/modismo/mariapalito/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/mariapalito/acepcion/2/ejemplo> ;
