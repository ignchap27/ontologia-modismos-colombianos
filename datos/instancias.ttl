<http://example.org/modcol/recurso/modismo/bareque/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bareque/acepcion/1/ejemplo> ;
    skos:definition "pared de palos entretejidos con cañas y barro"@es .

<http://example.org/modcol/recurso/modismo/bareque/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "casa de bahareque"@es .

<http://example.org/modcol/recurso/modismo/barequear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barequear/acepcion/1/ejemplo> ;
    skos:definition "En minería, sacar el oro de un yacimiento usando una batea para lavar la arena y lograr que se desprenda."@es .

<http://example.org/modcol/recurso/modismo/barequear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "A todo lo largo de los ríos mineros del Chocó, hombres y mujeres barequean en busca de las resplandecientes pepitas que se asientan en su batea."@es .

<http://example.org/modcol/recurso/modismo/barequeo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barequeo/acepcion/1/ejemplo> ;
    skos:definition "En la minería, extracción manual de metales preciosos de los ríos, lavando la arena para separar y recoger dichos metales."@es .

<http://example.org/modcol/recurso/modismo/barequeo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El barequeo como práctica de minería, se lleva a cabo con batea en los sedimentos de los ríos."@es .

<http://example.org/modcol/recurso/modismo/barequera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Vasija poco profunda y circular que se usa para barequear."@es .

<http://example.org/modcol/recurso/modismo/barequero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barequero/acepcion/1/ejemplo> ;
    skos:definition "Persona que trabaja en la minería artesanal, extrayendo manualmente los metales y piedras preciosas sin ayuda de maquinaria pesada."@es .

<http://example.org/modcol/recurso/modismo/barequero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ella es barequera desde niña, y asegura que no se ha ganado la vida de otra forma, al igual que sus hijos y su mamá."@es .

<http://example.org/modcol/recurso/modismo/bareta/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "cigarrillo de marihuana"@es .

<http://example.org/modcol/recurso/modismo/baretero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "que fuma marihuana"@es .

<http://example.org/modcol/recurso/modismo/bareto/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bareto/acepcion/1/ejemplo> ;
    skos:definition "Cigarrillo de marihuana."@es .

<http://example.org/modcol/recurso/modismo/bareto/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando abrí el armario de mi hermano mayor vi el bareto. Entonces era cierto: fumaba marihuana."@es .

<http://example.org/modcol/recurso/modismo/bareto/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "cigarrillo de marihuana"@es .

<http://example.org/modcol/recurso/modismo/barquilla/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barquilla/acepcion/1/ejemplo> ;
    skos:definition "Cono de galleta en el que se sirven las bolas de helado."@es .

<http://example.org/modcol/recurso/modismo/barquilla/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "También existen las barquillas tipo %isoft,%i populares en las cadenas de comida rápida."@es .

<http://example.org/modcol/recurso/modismo/barra/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barra/acepcion/1/ejemplo> ;
    skos:definition "Cantidad de dinero equivalente a un peso."@es .

<http://example.org/modcol/recurso/modismo/barra/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En algunos portales y estaciones hay que pagar 500 barras por usar el baño."@es .

<http://example.org/modcol/recurso/modismo/barra/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barra/acepcion/2/ejemplo> ;
    skos:definition "Grupo de personas que siguen y apoyan un equipo deportivo, un partido político o un artista."@es .

<http://example.org/modcol/recurso/modismo/barra/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Había dejado el ruido ensordecedor de los pitos y sirenas de las barras bullangueras que animaban a su manera a las candidatas en disputa."@es .

<http://example.org/modcol/recurso/modismo/barredura/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "en la minería, conjunto de operaciones para recoger todo el oro contenido en determinado lugar de un aluvión"@es .

<http://example.org/modcol/recurso/modismo/barrer/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barrer/acepcion/1/ejemplo> ;
    skos:definition "Pescar utilizando un trapo o red pequeña que se arrastra por el lecho del río para atrapar los peces que viven en aguas poco profundas."@es .

<http://example.org/modcol/recurso/modismo/barrer/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "También se acostumbra, a medida que se va barriendo, hurgar con un palo, los escondites de los peces para hacerlos salir."@es .

<http://example.org/modcol/recurso/modismo/barrer/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Hacer un despido masivo de empleados en una empresa."@es .

<http://example.org/modcol/recurso/modismo/barrera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barrera/acepcion/1/ejemplo> ;
    skos:definition "Plaza de toros de dos o tres pisos, construida en madera y guadua, con amarres de cabuya y puntilla, y palcos para el público."@es .

<http://example.org/modcol/recurso/modismo/barrera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Hay que armar una barrera para la corrida de las fiestas del pueblo, pero no sabemos en qué lugar levantarla."@es .

<http://example.org/modcol/recurso/modismo/barretón/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barretón/acepcion/1/ejemplo> ;
    skos:definition "Herramienta de labranza formada por un mango de madera y una paleta de hierro usada para abrir huecos."@es .

<http://example.org/modcol/recurso/modismo/barretón/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Nos enseñó cómo se manejaba el barretón, cómo se hacía un hueco, cómo se abonaba la tierra, cómo se ponía el árbol."@es .

<http://example.org/modcol/recurso/modismo/barrial/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barrial/acepcion/1/ejemplo> ;
    skos:definition "Lugar lleno de barro."@es .

<http://example.org/modcol/recurso/modismo/barrial/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando hace sol, no se resiste el polvero, y cuando llueve, el barrial es espantoso."@es .

<http://example.org/modcol/recurso/modismo/barrida/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barrida/acepcion/1/ejemplo> ;
    skos:definition "Despido masivo de empleados."@es .

<http://example.org/modcol/recurso/modismo/barrida/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se teme una barrida de profesores de cátedra, habida cuenta de las clases magistrales que se propone efectuar."@es .

<http://example.org/modcol/recurso/modismo/barrida/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "despido masivo de funcionarios o empleados"@es .

<http://example.org/modcol/recurso/modismo/barriga/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barriga/acepcion/1/ejemplo> ;
    skos:definition "Estar embarazada una mujer."@es .

<http://example.org/modcol/recurso/modismo/barriga/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando la mujer comienza a coger barriga y ya pasa el sofoco de la barriga, ya está el niño en gestación."@es .

<http://example.org/modcol/recurso/modismo/barriga/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barriga/acepcion/2/ejemplo> ;
    skos:definition "Disfraz hecho con prendas de vestir que una mujer usa en el vientre para simular un embarazo."@es .

<http://example.org/modcol/recurso/modismo/barriga/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pasaron los nueves meses y nunca nació el pelado (bis) /eso es mucha barriga de trapo, que jeroces."@es .

<http://example.org/modcol/recurso/modismo/barriga/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Barriga prominente."@es .

<http://example.org/modcol/recurso/modismo/barrigón/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Niño de corta edad."@es .

<http://example.org/modcol/recurso/modismo/barril/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barril/acepcion/1/ejemplo> ;
    skos:definition "Persona que no calma su apetito con nada."@es .

<http://example.org/modcol/recurso/modismo/barril/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El asado estuvo delicioso, creo que comí como un barril sin fondo."@es .

<http://example.org/modcol/recurso/modismo/barrilete/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barrilete/acepcion/1/ejemplo> ;
    skos:definition "Juguete de armazón liviana recubierta de tela, papel o plástico y una cola, que se eleva cuando hay viento y controlamos a través de un hilo grueso."@es .

<http://example.org/modcol/recurso/modismo/barrilete/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "También puede llevarlo [al niño] a la muralla a elevar un barrilete o al parque más cercano de la casa."@es .

<http://example.org/modcol/recurso/modismo/barrio/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barrio/acepcion/1/ejemplo> ;
    skos:definition "Cementerio."@es .

<http://example.org/modcol/recurso/modismo/barrio/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cada viernes y sábado, en la plaza de la panela, situada cerca del barrio de los acostados, llamado así por su vecindad con el cementerio, se negocia el valor de la carga."@es .

<http://example.org/modcol/recurso/modismo/barro/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barro/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que actúa con vileza, mala."@es .

<http://example.org/modcol/recurso/modismo/barro/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Que man tan barro, mira como trata a la hija."@es .

<http://example.org/modcol/recurso/modismo/barro/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barro/acepcion/2/ejemplo> ;
    skos:definition "Referido a una cosa, de mal gusto."@es .

<http://example.org/modcol/recurso/modismo/barro/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pusieron en los pisos del apartamento un recubrimiento de plástico que imita la madera, ¡qué barro!"@es .

<http://example.org/modcol/recurso/modismo/barulaque/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/barulaque/acepcion/1/ejemplo> ;
    skos:definition "Referido a un hombre joven, ocioso, que ocupa su tiempo en actividades no productivas."@es .

<http://example.org/modcol/recurso/modismo/barulaque/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Izque barulaque, también maqueta/Que yo no servía ni pa taco de escopeta./Yo sin contestale, por no escutí/Me saqué er tabaco pa poré escupí."@es .

<http://example.org/modcol/recurso/modismo/base/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/base/acepcion/1/ejemplo> ;
    skos:definition "En el béisbol, avanzar una base un corredor mientras se ejecuta un lanzamiento o el equipo defensor comete un error."@es .

<http://example.org/modcol/recurso/modismo/base/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El %icatcher %iera bastante malo, soltó la bola y el corredor en segunda alcanzó a robarse la tercera base."@es .

<http://example.org/modcol/recurso/modismo/bastimento/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bastimento/acepcion/1/ejemplo> ;
    skos:definition "Conjunto de verduras, hortalizas y granos con los que se preparan algunas sopas."@es .

<http://example.org/modcol/recurso/modismo/bastimento/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Todos nos alegramos cuando la olla de la sopa comienza a hervir, aseguró una amiga de Astrid, que ayuda a pelar y lavar el bastimento."@es .

<http://example.org/modcol/recurso/modismo/bastimento/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bastimento/acepcion/2/ejemplo> ;
    skos:definition "Provisión de comida que se lleva para consumir en las faenas del campo o en un viaje."@es .

<http://example.org/modcol/recurso/modismo/bastimento/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Salió temprano de Santa Rosalía en donde había logrado comprar bastimento para el viaje y un mercado de grano para el pariente."@es .

<http://example.org/modcol/recurso/modismo/bastonero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bastonero/acepcion/1/ejemplo> ;
    skos:definition "Persona que encabeza un desfile y durante la marcha mueve el bastón al ritmo de la música."@es .

<http://example.org/modcol/recurso/modismo/bastonero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Todos llegaron el día de la prueba. Hasta la banda de la universidad y sus lindas bastoneras estaban allí."@es .

<http://example.org/modcol/recurso/modismo/basuco/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "cigarrillo de fuertes efectos alucinógenos, preparado a base de una mezcla de cocaína, marihuana y otras sustancias"@es .

<http://example.org/modcol/recurso/modismo/basuquear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "fumar cigarrillo de basuco"@es .

<http://example.org/modcol/recurso/modismo/basuquero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "persona adicta al basuco o que comercia con este alucinógeno"@es .

<http://example.org/modcol/recurso/modismo/bata/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bata/acepcion/1/ejemplo> ;
    skos:definition "Salir a divertirse."@es .

<http://example.org/modcol/recurso/modismo/bata/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Decidió alzarse la bata y bailó toda la noche sin que nada pudiera evitarlo."@es .

<http://example.org/modcol/recurso/modismo/bataclana/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bataclana/acepcion/1/ejemplo> ;
    skos:definition "Prostituta."@es .

<http://example.org/modcol/recurso/modismo/bataclana/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Como una bataclana venida a menos entra, haciendo equilibrio a cada zancada, sobre recién estrenados zapatos de tacón."@es .

<http://example.org/modcol/recurso/modismo/batanear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/batanear/acepcion/1/ejemplo> ;
    skos:definition "Molestar o causar disgusto a alguien"@es .

<http://example.org/modcol/recurso/modismo/batanear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se reunían a bataniar gente, no le perdonaban a nadie, no importa que uno no les hiciera mala cara, que uno siquiera los mirara."@es .

<http://example.org/modcol/recurso/modismo/batata/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "pantorrilla"@es .

<http://example.org/modcol/recurso/modismo/bate/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Hombre bien parecido, atractivo físicamente."@es .

<http://example.org/modcol/recurso/modismo/batea/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/batea/acepcion/1/ejemplo> ;
    skos:definition "Recipiente de madera o metálico que se usa para lavar arena, separar el oro."@es .

<http://example.org/modcol/recurso/modismo/batea/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Va sacudiendo su batea para separar la tierra de la jagua, un polvillo metálico y negruzco sin valor comercial."@es .

<http://example.org/modcol/recurso/modismo/batea/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
