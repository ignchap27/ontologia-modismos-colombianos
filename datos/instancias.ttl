<http://example.org/modcol/recurso/modismo/marramuncia/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Hemos visto cómo valientes periodistas lo han confrontado con agudas preguntas que han expuesto al público sus marramuncias."@es .

<http://example.org/modcol/recurso/modismo/marramuncia/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/marramuncia/acepcion/2/ejemplo> ;
