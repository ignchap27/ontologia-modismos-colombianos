<http://example.org/modcol/recurso/modismo/papujo/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/papujo/acepcion/3/ejemplo> ;
