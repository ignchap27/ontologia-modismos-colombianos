<http://example.org/modcol/recurso/modismo/socolar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Yo socolé un montecito a orillas de un caño. Corté unas hojas de palma milpesos y me hice una enramada para que a la familia no le diera el sereno."@es .

<http://example.org/modcol/recurso/modismo/socolar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "desmontar un terreno dejando los árboles grandes. ¿cómo va a dejar de socolar sus montes, [ .] por atenderme a mí"@es .

<http://example.org/modcol/recurso/modismo/soda/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/soda/acepcion/1/ejemplo> ;
