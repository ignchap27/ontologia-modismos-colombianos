    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "caerse alguien desde un barranco o precipio"@es .

<http://example.org/modcol/recurso/modismo/desbarrancarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/desbarrancarse/acepcion/1/ejemplo> ;
    skos:definition "Caerse alguien o algo desde un sitio alto y escarpado."@es .

<http://example.org/modcol/recurso/modismo/desbarrancarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "A los pocos días su amigo murió en un accidente de tránsito, el carro se le desbarrancó en la carretera a su finca y explotó contra un árbol."@es .

<http://example.org/modcol/recurso/modismo/desbarrancarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Desprenderse parte de un cerro."@es .

<http://example.org/modcol/recurso/modismo/desbocado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "referido a personas o animales, que van a gran velocidad"@es .

<http://example.org/modcol/recurso/modismo/desboronar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido al pan, deshacerlo en migajas."@es .

<http://example.org/modcol/recurso/modismo/desboronar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/desboronar/acepcion/2/ejemplo> ;
    skos:definition "Deshacerse algo en muchas partes pequeñas."@es .

<http://example.org/modcol/recurso/modismo/desboronar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Es importante tomar estas medidas, un vidrio laminado de seguridad al momento de un golpe se va a ‘chitear’ y no a desboronar."@es .

<http://example.org/modcol/recurso/modismo/desbrevada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "dedicación intensa al estudio"@es .

<http://example.org/modcol/recurso/modismo/desbrevarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "dedicarse intensamente a una cosa, en especial al estudio"@es .

<http://example.org/modcol/recurso/modismo/descabezar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descabezar/acepcion/1/ejemplo> ;
    skos:definition "destituir a una persona de un cargo o empleo, o frustrarle una aspiración"@es .

<http://example.org/modcol/recurso/modismo/descabezar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "lo descabezaron de la lista para el senado"@es .

<http://example.org/modcol/recurso/modismo/descabezar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Destituir a una persona de su cargo."@es .

<http://example.org/modcol/recurso/modismo/descachado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que pierde la moderación o no acierta en sus acciones o afirmaciones."@es .

<http://example.org/modcol/recurso/modismo/descachado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Uno de los primeros y más reconocidos personajes del actor fue un descachado hombre que siempre se metía en empresas sin rumbo y negocios fallidos."@es .

<http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/1/ejemplo> ;
    skos:definition "descuidado en el vestir"@es .

<http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "esa vigüela que suena/tiene la boca rasgada y también el que la toca/tiene su escachalandrada"@es .

<http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "dicho de una persona, descuidada en el vestir y en su apariencia"@es .

<http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/3/ejemplo> ;
    skos:definition "Referido a una persona, descuidada en su forma de vestir."@es .

<http://example.org/modcol/recurso/modismo/descachalandrado/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El otrora descachalandrado figurante de la bohemia céntrica bogotana tiene por estos días el semblante y la facha de un tipo de fiar."@es .

<http://example.org/modcol/recurso/modismo/descachalandrarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "descuidarse en el vestido y aspecto personal"@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Remover los cuernos del ganado."@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachar/acepcion/2/ejemplo> ;
    skos:definition "Hacer un comentario inapropiado o equivocado de alguien o alguna situación."@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Qué estaría pensando la comunicadora que se descachó de lo feo!"@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "caerse la cacha o mango de una herramienta"@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "descornar, quitar los cuernos a un animal"@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/5> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachar/acepcion/5/ejemplo> ;
    skos:definition "Equivocarse en algo."@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/5/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La institución prometió un programa virtual y, hasta la novedad que presentó, operó exitosamente en la metodología e-Learning. Pero ahora, como decimos en Colombia, se 'descacharon'."@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/6> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachar/acepcion/6/ejemplo> ;
    skos:definition "Romperse el eje en un vehículo."@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/6/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La llanta delantera izquierda se descachó de un momento a otro."@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/7> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descachar/acepcion/7/ejemplo> ;
    skos:definition "cometer una indiscreción"@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/7/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "se descacharon con ese comentario"@es .

<http://example.org/modcol/recurso/modismo/descachar/acepcion/8> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "romperse los ejes o cachos que sostienen las ruedas de un vehículo"@es .

<http://example.org/modcol/recurso/modismo/descachazar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "limpiar de cachaza el guarapo de caña cuando está hirviendo para obtener miel"@es .

<http://example.org/modcol/recurso/modismo/descaderado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una prenda de vestir, especialmente un pantalón o ropa interior, que se ajusta por debajo de la cintura."@es .

<http://example.org/modcol/recurso/modismo/descalzurriado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descalzurriado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que lleva los pantalones escurridos, por debajo de la cintura."@es .

<http://example.org/modcol/recurso/modismo/descalzurriado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Primero vístase bien, nada peor que un descalzurriado de esos a los que el pantalón no lo sostiene el cinturón, dijo el profesor en clase."@es .

<http://example.org/modcol/recurso/modismo/descalzurriado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, que está mal vestida."@es .

<http://example.org/modcol/recurso/modismo/descambiar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descambiar/acepcion/1/ejemplo> ;
    skos:definition "cambiar billetes o monedas por su equivalente en otros de menor denominación"@es .

<http://example.org/modcol/recurso/modismo/descambiar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "quién me puede descambiar este billete"@es .

<http://example.org/modcol/recurso/modismo/descambiar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descambiar/acepcion/2/ejemplo> ;
    skos:definition "Cambiar billetes o monedas por la misma cantidad, pero en denominaciones de menor valor."@es .

<http://example.org/modcol/recurso/modismo/descambiar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Entonces descambié los billetes con un viejo que detrás de una ventanilla los puso uno por uno en la maquinita."@es .

<http://example.org/modcol/recurso/modismo/descapuruzado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descapuruzado/acepcion/1/ejemplo> ;
    skos:definition "Referido una persona, que tiene el cabello desordenado o desarreglado."@es .

<http://example.org/modcol/recurso/modismo/descapuruzado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Niña, péinese un poco porque está descapuruzada."@es .

<http://example.org/modcol/recurso/modismo/descapuruzar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Dañar el cuidado de un peinado."@es .

<http://example.org/modcol/recurso/modismo/descarachar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descarachar/acepcion/1/ejemplo> ;
    skos:definition "Desprender una costra de la herida."@es .

<http://example.org/modcol/recurso/modismo/descarachar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No tendría sentido ‘descarachar’ las heridas en proceso de cicatrizar, causadas al paisaje y a las arcas municipales por importantes personajes."@es .

<http://example.org/modcol/recurso/modismo/descerezar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descerezar/acepcion/1/ejemplo> ;
    skos:definition "Quitar la pulpa a la semilla del café para que pierda el dulce introduciéndolo en agua."@es .

<http://example.org/modcol/recurso/modismo/descerezar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La principal recomendación que los expertos hicieron a los caficultores, es evitar el uso excesivo de agua para descerezar el fruto."@es .

<http://example.org/modcol/recurso/modismo/deschavetarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/deschavetarse/acepcion/1/ejemplo> ;
    skos:definition "Enloquecer."@es .

<http://example.org/modcol/recurso/modismo/deschavetarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando se rapó la cabeza frente a las cámaras, dijimos, \"pobre vieja, se deschavetó”."@es .

<http://example.org/modcol/recurso/modismo/deschavetarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "volverse alguien loco"@es .

<http://example.org/modcol/recurso/modismo/desclarar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "inclinar suavemente una vasija para hacer salir el líquido sin remover el sedimento"@es .

<http://example.org/modcol/recurso/modismo/descobalar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descobalar/acepcion/1/ejemplo> ;
    skos:definition "Torcer."@es .

<http://example.org/modcol/recurso/modismo/descobalar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La moto sufrió mucho en el destapado, lo que hizo que debiéramos mandar a rectificar el rin delantero, pues se había descobalado por una piedra en el camino."@es .

<http://example.org/modcol/recurso/modismo/desconchinflado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/desconchinflado/acepcion/1/ejemplo> ;
    skos:definition "Referido a algo o a alguien, maltrecho, desordenado o deteriorado."@es .

<http://example.org/modcol/recurso/modismo/desconchinflado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ya le conté al doctor que caminas tullido y dice que seguramente algo se te ha desconchinflado en las corvas."@es .

<http://example.org/modcol/recurso/modismo/desconectar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/desconectar/acepcion/1/ejemplo> ;
    skos:definition "Esterilizar a una mujer a través de la ligadura de trompas."@es .

<http://example.org/modcol/recurso/modismo/desconectar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El año pasado me desconectaron, es que ya tengo tres."@es .

<http://example.org/modcol/recurso/modismo/descorche/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "cantidad de dinero que se paga en un restaurante o bar por llevar las bebidas alcohólicas que uno piensa consumir allí"@es .

<http://example.org/modcol/recurso/modismo/descorche/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descorche/acepcion/2/ejemplo> ;
    skos:definition "Dinero que se paga en un restaurante o en un bar por el derecho a llevar las bebidas alcohólicas."@es .

<http://example.org/modcol/recurso/modismo/descorche/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "'No aceptamos que usted traiga su vino, ni pagando el descorche, porque aquí tenemos vinos'."@es .

<http://example.org/modcol/recurso/modismo/descrestada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "acción y efecto de descrestar"@es .

<http://example.org/modcol/recurso/modismo/descrestador/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descrestador/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona o situación, que sorprende o impresiona positivamente a los demás, a veces sin ser cierto."@es .

<http://example.org/modcol/recurso/modismo/descrestador/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Diríamos mejor, sólo ese grupo puede creer el 'empastelado' de conceptos que armó un artículo descrestador que produce carcajadas, pero que es irreal."@es .

<http://example.org/modcol/recurso/modismo/descrestador/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "persona que aparenta ser lo que no es"@es .

<http://example.org/modcol/recurso/modismo/descrestar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descrestar/acepcion/1/ejemplo> ;
    skos:definition "Impresionar alguien o algo a otra persona por sus cualidades excepcionales."@es .

<http://example.org/modcol/recurso/modismo/descrestar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cinco de las mejores chefs del país nos recomiendan exquisitas recetas para descrestar a papá, basadas todas en muy buenos licores."@es .

<http://example.org/modcol/recurso/modismo/descrestar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descrestar/acepcion/2/ejemplo> ;
    skos:definition "e . producir admiración, impresionar a alguien"@es .

<http://example.org/modcol/recurso/modismo/descrestar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "el conferencista descrestó al auditorio por sus conocimientos"@es .

<http://example.org/modcol/recurso/modismo/descreste/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descreste/acepcion/1/ejemplo> ;
    skos:definition "Demostración sorprendente de algo por sus cualidades positivas."@es .

<http://example.org/modcol/recurso/modismo/descreste/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se impactaron por la tecnología de punta de la que ahora disfrutan, con los computadores y los tableros táctiles que son todo un 'descreste'."@es .

<http://example.org/modcol/recurso/modismo/descuajado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/descuajado/acepcion/1/ejemplo> ;
    skos:definition "En la tradición popular y referido especialmente a un niño, enfermo con diarrea y otros síntomas a causa de una lesión en la cavidad abdominal en la que un golpe o una fuerte impresión alteran la disposición normal de los órganos internos."@es .

<http://example.org/modcol/recurso/modismo/descuajado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Aunque en el Llano curan a hielados o descuajados con prácticas caseras, lo ideal es acudir al médico."@es .

<http://example.org/modcol/recurso/modismo/descuajaringado/acepcion/1> a mc:Acepcion ;
