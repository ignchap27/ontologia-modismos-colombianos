<http://example.org/modcol/recurso/modismo/rolis/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si quiere divertirse la próxima semana, pues le recomendamos darse un ‘rolis’ por los museos para que disfrute de las exposiciones."@es .

<http://example.org/modcol/recurso/modismo/rollo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rollo/acepcion/1/ejemplo> ;
