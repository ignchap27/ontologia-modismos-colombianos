<http://example.org/modcol/recurso/modismo/guatín/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/guatín/acepcion/1/ejemplo> ;
    skos:definition "Danza de salón típica de Antioquia en la que la pareja baila suelta con movimientos independientes y rápidos, y mientras la mujer da muchas vueltas el hombre baila alrededor de ella."@es .

<http://example.org/modcol/recurso/modismo/guatín/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En la actualidad el guatín no tiene vigencia popular masiva, sólo queda en el recuerdo de personas ya entradas en años, que la bailan ocasionalmente."@es .

<http://example.org/modcol/recurso/modismo/guatín/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/guatín/acepcion/2/ejemplo> ;
