    mc:textoEjemplo "No vengas ahora con una mano de problemas sin resolver."@es .

<http://example.org/modcol/recurso/modismo/ungir/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/ungir/acepcion/1/ejemplo> ;
