<http://example.org/modcol/recurso/modismo/neme/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Lo que pasa es que en verano se derrite el pavimento y quedan manchas como de “neme”, que llama uno aquí."@es .

<http://example.org/modcol/recurso/modismo/nemesias/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/nemesias/acepcion/1/ejemplo> ;
