<http://example.org/modcol/recurso/modismo/chamba/acepcion/4/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La idea es procesar la fruta y, con el tiempo, guardarla en cuartos fríos con el respectivo proceso de pasteurización para tener chamba durante todo el año, ya que los árboles dan fruto en agosto y septiembre."@es .

<http://example.org/modcol/recurso/modismo/chamba/acepcion/5> a mc:Acepcion ;
