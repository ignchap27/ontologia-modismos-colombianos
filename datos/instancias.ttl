<http://example.org/modcol/recurso/modismo/salsamentaria/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Establecimiento especializado en la venta de embutidos y carnes frías."@es .

<http://example.org/modcol/recurso/modismo/salsómano/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salsómano/acepcion/1/ejemplo> ;
