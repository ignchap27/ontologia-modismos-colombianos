<http://example.org/modcol/recurso/modismo/flauta/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pasta lista para empanadas y flautas."@es .

<http://example.org/modcol/recurso/modismo/flauta/acepcion/2> a mc:Acepcion ;
