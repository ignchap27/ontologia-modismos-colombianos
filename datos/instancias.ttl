<http://example.org/modcol/recurso/modismo/marcar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El acto de besar es referido como marcar, marcarse y más recientemente por los jóvenes como rumbear."@es .

<http://example.org/modcol/recurso/modismo/marconi/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
