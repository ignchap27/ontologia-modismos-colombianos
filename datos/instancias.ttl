<http://example.org/modcol/recurso/modismo/carreta/acepcion/5> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/carreta/acepcion/5/ejemplo> ;
