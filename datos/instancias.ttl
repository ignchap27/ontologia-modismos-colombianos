<http://example.org/modcol/recurso/modismo/rayudo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Por ejemplo, está el jugador ‘rayúo’, que busca los marcos o las piedras que conforman los arcos y busca el balón."@es .

<http://example.org/modcol/recurso/modismo/rayudo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
