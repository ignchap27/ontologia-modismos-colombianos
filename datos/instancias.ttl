<http://example.org/modcol/recurso/modismo/chiveado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Según el periódico de ayer, creció el flagelo de los celulares 'chiviados' en ciertas ciudades del país."@es .

<http://example.org/modcol/recurso/modismo/chivear/acepcion/1> a mc:Acepcion ;
