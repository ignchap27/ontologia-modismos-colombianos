<http://example.org/modcol/recurso/modismo/patada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/patada/acepcion/1/ejemplo> ;
