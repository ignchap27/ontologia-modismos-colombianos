    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/casco/acepcion/1/ejemplo> ;
    skos:definition "Cada una de las piezas en las que están divididos naturalmente algunos frutos, especialmente los cítricos."@es .

<http://example.org/modcol/recurso/modismo/casco/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La torta estaba decorada con dos cascos de mandarina."@es .

