<http://example.org/modcol/recurso/modismo/capellanía/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "la hacienda tiene la capellanía del camino público"@es .

<http://example.org/modcol/recurso/modismo/caperuza/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "en las lámparas de querosene, tejido sedoso en forma de un pequeño globo o bolsita que funciona como mecha y produce la luz al ponerse incandescente"@es .

<http://example.org/modcol/recurso/modismo/caperuza/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
