<http://example.org/modcol/recurso/modismo/abozao/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El grupo de Chocó bailó Voltea en ritmo de abozao que es una danza folclórica del Pacífico colombiano."@es .

<http://example.org/modcol/recurso/modismo/abra/acepcion/1> a mc:Acepcion ;
