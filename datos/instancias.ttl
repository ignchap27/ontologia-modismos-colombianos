<http://example.org/modcol/recurso/modismo/jacho/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El tipo es un jacho, se estrella con todos y tumba cuanto se le atraviesa en el camino."@es .

<http://example.org/modcol/recurso/modismo/jai/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
