    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "sinvergüenza, que le gusta aprovecharse de los demás"@es .

<http://example.org/modcol/recurso/modismo/cachetero/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cachetero/acepcion/2/ejemplo> ;
    skos:definition "Sinvergüenza, que busca comer y beber a expensas de otros."@es .

<http://example.org/modcol/recurso/modismo/cachetero/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Yo creo que él era el cachetero número uno de Cali y elegante porque solo te cacheteaba whisky."@es .

<http://example.org/modcol/recurso/modismo/cachetero/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cachetero/acepcion/3/ejemplo> ;
    skos:definition "Prenda interior femenina en forma de pantaloneta de mangas muy cortas."@es .

<http://example.org/modcol/recurso/modismo/cachetero/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ella manda a estampar sus calzones. Específicamente sus cacheteros: le gustan los mensajes directos y en inglés."@es .

<http://example.org/modcol/recurso/modismo/cachezudo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cachezudo/acepcion/1/ejemplo> ;
    skos:definition "Fino, con mucha distinción o elegancia."@es .

<http://example.org/modcol/recurso/modismo/cachezudo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
