<http://example.org/modcol/recurso/modismo/mariapalito/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Lo primero que hizo fue comprarse una mariapalito y se sentó en la puerta de su casa a mecerse todo el día."@es .

<http://example.org/modcol/recurso/modismo/mariapalito/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
