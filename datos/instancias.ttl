<http://example.org/modcol/recurso/modismo/estar-vaciado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "estar de malas, sin dinero, con problemas"@es .

<http://example.org/modcol/recurso/modismo/estartazo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/estartazo/acepcion/1/ejemplo> ;
