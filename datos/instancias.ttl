<http://example.org/modcol/recurso/modismo/lapo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "trago de licor"@es .

<http://example.org/modcol/recurso/modismo/lapo/acepcion/2> a mc:Acepcion ;
