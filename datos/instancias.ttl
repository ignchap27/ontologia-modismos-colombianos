    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/patear/acepcion/1/ejemplo> ;
    skos:definition "Escuchar con detenimiento una conversación ajena o presenciar una situación a modo de testigo."@es .

<http://example.org/modcol/recurso/modismo/patear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Llegando a la oficina me pateé un accidente impresionante entre dos carros."@es .

<http://example.org/modcol/recurso/modismo/patear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
