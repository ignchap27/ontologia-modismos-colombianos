<http://example.org/modcol/recurso/modismo/encuartelar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Yo, como madre de tres hijos varones más, no permitiré que me los encuartelen a todos."@es .

<http://example.org/modcol/recurso/modismo/encuartelar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
