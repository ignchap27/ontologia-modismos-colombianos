<http://example.org/modcol/recurso/modismo/jardín/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El Secretario de Educación anunció que en el sistema preescolar de los colegios públicos de Bogotá se abrirán los tres grados: prejardín, jardín y transición."@es .

<http://example.org/modcol/recurso/modismo/jardín/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/jardín/acepcion/3/ejemplo> ;
