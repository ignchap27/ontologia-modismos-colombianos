<http://example.org/modcol/recurso/modismo/cojongo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con el mote un poco fermentado se hacen las empanadas y tamales, los fideos, las carantantas, los cojongos."@es .

<http://example.org/modcol/recurso/modismo/cojongo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
