<http://example.org/modcol/recurso/modismo/instalación/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "instalación del congreso nacional; instalación de una junta directiva"@es .

<http://example.org/modcol/recurso/modismo/intenso/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/intenso/acepcion/1/ejemplo> ;
