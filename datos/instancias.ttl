    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Persona con la que se tienen relaciones sexuales de manera ocasional."@es .

<http://example.org/modcol/recurso/modismo/entuque/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/entuque/acepcion/2/ejemplo> ;
    skos:definition "Noviazgo informal, pasajero."@es .

<http://example.org/modcol/recurso/modismo/entuque/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Usted es que tiene un entuque o qué?, ¿para qué tan linda?”."@es .

<http://example.org/modcol/recurso/modismo/entusado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/entusado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que está triste y melancólica por haber peleado o terminado con su pareja."@es .

<http://example.org/modcol/recurso/modismo/entusado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando se está entusado por primera vez uno siempre dice que no volverá a creer en el amor, sólo quiere emborracharse y hasta meterse a un monasterio."@es .

<http://example.org/modcol/recurso/modismo/envainado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/envainado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona o situación, estar en problemas o ser problemática."@es .

<http://example.org/modcol/recurso/modismo/envainado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los países tienen intereses y no amigos. Esta trillada frase de Palmerston es lo primero que aprenden —o deberían aprender— los cancilleres de un país envainado."@es .

<http://example.org/modcol/recurso/modismo/envainar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/envainar/acepcion/1/ejemplo> ;
    skos:definition "Meter a alguien en problemas."@es .

<http://example.org/modcol/recurso/modismo/envainar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con sus declaraciones envainó a más de un político en el proceso que se investiga."@es .

<http://example.org/modcol/recurso/modismo/enverracar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enverracar/acepcion/1/ejemplo> ;
    skos:definition "Enfurecerse."@es .

<http://example.org/modcol/recurso/modismo/enverracar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "También me emberraca que me rayen el bómper del carro cuando se pasan de un carril a otro en tráfico."@es .

<http://example.org/modcol/recurso/modismo/enverracarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "enfurecerse"@es .

<http://example.org/modcol/recurso/modismo/enverriondar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enverriondar/acepcion/1/ejemplo> ;
    skos:definition "Llenarse de coraje y valentía."@es .

<http://example.org/modcol/recurso/modismo/enverriondar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Vamos equipo, hay que enverriondarse pa' sacar esto pa'lante!"@es .

<http://example.org/modcol/recurso/modismo/enverriondar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
