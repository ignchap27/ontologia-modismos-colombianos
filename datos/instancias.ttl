<http://example.org/modcol/recurso/modismo/burletero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Más adelante me convertí en una adolescente rumbera, contestataria, burletera e indisciplinada."@es .

<http://example.org/modcol/recurso/modismo/burletero/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
