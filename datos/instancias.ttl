<http://example.org/modcol/recurso/modismo/burro/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tacó burro, burrísimo, la Comisión Nacional de Televisión que se apresuró a tomar una medida de fuerza, llevada por argumentos de falsa moral."@es .

<http://example.org/modcol/recurso/modismo/burundanga/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/burundanga/acepcion/1/ejemplo> ;
