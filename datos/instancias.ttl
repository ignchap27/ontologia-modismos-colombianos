<http://example.org/modcol/recurso/modismo/rila/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Prefiero una carne magra, pulpita, sin gordo ni rilas."@es .

<http://example.org/modcol/recurso/modismo/ringlete/acepcion/1> a mc:Acepcion ;
