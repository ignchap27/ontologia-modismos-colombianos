<http://example.org/modcol/recurso/modismo/atenerse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atenerse/acepcion/1/ejemplo> ;
    skos:definition "Hacer recaer sobre otros las obligaciones o responsabilidades propias."@es .

<http://example.org/modcol/recurso/modismo/atenerse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En vez de atenerte a que tu mamá te pida la cita llama tú y solicítala."@es .

<http://example.org/modcol/recurso/modismo/atenido/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atenido/acepcion/1/ejemplo> ;
