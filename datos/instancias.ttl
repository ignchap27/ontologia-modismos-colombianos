    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/marimba/acepcion/1/ejemplo> ;
    skos:definition "Instrumento musical de percusión con láminas de madera de distintos tamaños, organizadas sobre un armazón y tubos resonadores, que se toca con unas baquetas."@es .

<http://example.org/modcol/recurso/modismo/marimba/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En las riberas del río Guapi se elabora la marimba de modo artesanal, en rústicos talleres donde viejos fabricantes le otorgan a la guadua un sonido característico."@es .

<http://example.org/modcol/recurso/modismo/marimba/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Marihuana."@es .

<http://example.org/modcol/recurso/modismo/marimbear/acepcion/1> a mc:Acepcion ;
