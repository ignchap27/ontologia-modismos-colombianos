<http://example.org/modcol/recurso/modismo/estar-o-dejarse-meter-en-el-cuento/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/estar-o-dejarse-meter-en-el-cuento/acepcion/1/ejemplo> ;
