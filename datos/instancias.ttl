<http://example.org/modcol/recurso/modismo/conjunto/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Una de las alternativas de seguridad que más les interesa a los ciudadanos es comprar su vivienda en conjunto cerrado."@es .

<http://example.org/modcol/recurso/modismo/conmutador/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Aparato electrónico de telecomunicaciones que comunica varias líneas telefónicas ubicadas en diversos lugares de una misma entidad."@es .

<http://example.org/modcol/recurso/modismo/connotado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/connotado/acepcion/1/ejemplo> ;
