    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/contentar/acepcion/1/ejemplo> ;
    skos:definition "Hacer las paces dos personas, luego de una pelea o disgusto."@es .

<http://example.org/modcol/recurso/modismo/contentar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Finalmente, luego de tantos años, Juan y Marina se contentaron y hablaron tranquilamente."@es .

<http://example.org/modcol/recurso/modismo/contentillo/acepcion/1> a mc:Acepcion ;
