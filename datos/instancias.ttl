<http://example.org/modcol/recurso/modismo/combo/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/combo/acepcion/3/ejemplo> ;
