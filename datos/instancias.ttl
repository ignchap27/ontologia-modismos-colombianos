    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rascado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, borracha."@es .

<http://example.org/modcol/recurso/modismo/rascado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se fueron de rumba el sábado y llegaron de madrugada rascadas a la casa de una amiga."@es .

<http://example.org/modcol/recurso/modismo/rascar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/rascar/acepcion/1/ejemplo> ;
