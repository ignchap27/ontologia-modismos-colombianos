    skos:definition "palabra comodín que puede designar cualquier cosa"@es .

<http://example.org/modcol/recurso/modismo/joda/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "alcánceme la joda esa"@es .

<http://example.org/modcol/recurso/modismo/joda/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/joda/acepcion/3/ejemplo> ;
    skos:definition "Situación desagradable, contrariedad."@es .

<http://example.org/modcol/recurso/modismo/joda/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Esto sí es vida, decía, y no esta joda que me produce unas cosquillas más próximas al resentimiento que a la decepción o a la angustia."@es .

<http://example.org/modcol/recurso/modismo/jodencia/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
