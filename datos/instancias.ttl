<http://example.org/modcol/recurso/modismo/carranguero/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "persona que interpreta música carranguera"@es .

<http://example.org/modcol/recurso/modismo/carraquear/acepcion/1> a mc:Acepcion ;
