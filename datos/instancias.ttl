<http://example.org/modcol/recurso/modismo/bómper/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se conserva la seguridad y durabilidad de los bómperes, elementos de gran importancia en caso de colisión o golpes leves."@es .

<http://example.org/modcol/recurso/modismo/bóveda/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/bóveda/acepcion/1/ejemplo> ;
