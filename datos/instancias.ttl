<http://example.org/modcol/recurso/modismo/estar-en-el-cuento/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/estar-en-el-cuento/acepcion/1/ejemplo> ;
    skos:definition "Estar dedicado a un proyecto, actividad o asunto."@es .

<http://example.org/modcol/recurso/modismo/estar-en-el-cuento/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Leo recuerda que en la ciénaga hay unos mangles y yo estoy en el cuento de los paseos a los turistas, vamos."@es .

<http://example.org/modcol/recurso/modismo/estar-en-el-curubito/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "ocupar una posición importante"@es .

<http://example.org/modcol/recurso/modismo/estar-en-pinta/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "estar casi borracho"@es .

<http://example.org/modcol/recurso/modismo/estar-esperando/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "estar embarazada"@es .

<http://example.org/modcol/recurso/modismo/estar-joche/acepcion/1> a mc:Acepcion ;
