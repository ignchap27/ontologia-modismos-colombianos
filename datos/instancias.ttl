<http://example.org/modcol/recurso/modismo/arreo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arreo/acepcion/2/ejemplo> ;
    skos:definition "Traslado del ganado de un lado a otro."@es .

<http://example.org/modcol/recurso/modismo/arreo/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Un nuevo día comienza, el cabestrero monta su caballo, comienza su labor de arreo y libera una copla emocional."@es .

<http://example.org/modcol/recurso/modismo/arrequintar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "arreglar o componer la carga de las bestias"@es .

<http://example.org/modcol/recurso/modismo/arrevolverado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "insolente, agresivo"@es .

<http://example.org/modcol/recurso/modismo/arrevolverado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrevolverado/acepcion/2/ejemplo> ;
    skos:definition "malgeniado, de trato difícil"@es .

<http://example.org/modcol/recurso/modismo/arrevolverado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "así son las mujeres: mientras uno más las quiere más arrivolveradas se vuelven"@es .

<http://example.org/modcol/recurso/modismo/arrevolverarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Alborotarse, animarse demasiado."@es .

<http://example.org/modcol/recurso/modismo/arriado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arriado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que no cuenta con recursos económicos."@es .

<http://example.org/modcol/recurso/modismo/arriado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Como se quedó sin empleo, ahora anda arriado buscando cómo pagar el arriendo."@es .

<http://example.org/modcol/recurso/modismo/arribar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arribar/acepcion/1/ejemplo> ;
    skos:definition "Llegar a un lugar generalmente por vía aérea."@es .

<http://example.org/modcol/recurso/modismo/arribar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "A Bogotá arribaron cientos de delegados de las organizaciones agrarias."@es .

<http://example.org/modcol/recurso/modismo/arrimadero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrimadero/acepcion/1/ejemplo> ;
    skos:definition "Muelle al que se acercan las canoas a lo largo de los ríos."@es .

<http://example.org/modcol/recurso/modismo/arrimadero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El entorno que la rodea y la calle forman parte del imaginario de territorio, junto con otros espacios, como el arrimadero de balsas, la vía pública."@es .

<http://example.org/modcol/recurso/modismo/arrimado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrimado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que se aloja en una casa ajena y vive de los recursos del dueño."@es .

<http://example.org/modcol/recurso/modismo/arrimado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "\"No estoy de acuerdo con que los recién casados vivan arrimados en casa de los suegros\", dijo el sacerdote que presidió la boda."@es .

<http://example.org/modcol/recurso/modismo/arrimar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrimar/acepcion/1/ejemplo> ;
    skos:definition "Ir donde una persona o a un sitio."@es .

<http://example.org/modcol/recurso/modismo/arrimar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Arrimemos a la casa de Carlos que él nos da posada."@es .

<http://example.org/modcol/recurso/modismo/arrimar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrimar/acepcion/2/ejemplo> ;
    skos:definition "Vivir una persona a expensas de otra provocándole molestias."@es .

<http://example.org/modcol/recurso/modismo/arrimar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Es doloroso arrimarse a los hermanos, pedir prestado a los amigos, acabar con la vida social."@es .

<http://example.org/modcol/recurso/modismo/arriscar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arriscar/acepcion/1/ejemplo> ;
    skos:definition "doblar o doblarse algo hacia arriba"@es .

<http://example.org/modcol/recurso/modismo/arriscar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "el caballo arriscó las orejas; arriscar el sombrero"@es .

<http://example.org/modcol/recurso/modismo/arriscar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arriscar/acepcion/2/ejemplo> ;
    skos:definition "alcanzar, lograr, tener fuerza suficiente para hacer algo"@es .

<http://example.org/modcol/recurso/modismo/arriscar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "no arriscó con las maletas. no arriscó a llegar a la cumbre"@es .

<http://example.org/modcol/recurso/modismo/arriscar/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arriscar/acepcion/3/ejemplo> ;
    skos:definition "Lograr o ser capaz de hacer algo."@es .

<http://example.org/modcol/recurso/modismo/arriscar/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tuvo una carrera meritoria, pero cuando le tocaron las dificultades, no arriscó con ellas."@es .

<http://example.org/modcol/recurso/modismo/arrivolverado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "insolente, agresivo"@es .

<http://example.org/modcol/recurso/modismo/arrivolverado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrivolverado/acepcion/2/ejemplo> ;
    skos:definition "malgeniado, de trato difícil"@es .

<http://example.org/modcol/recurso/modismo/arrivolverado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "así son las mujeres: mientras uno más las quiere más arrivolveradas se vuelven"@es .

<http://example.org/modcol/recurso/modismo/arrodillado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrodillado/acepcion/1/ejemplo> ;
    skos:definition "Persona que se somete sin resistencia a la voluntad o a la autoridad de otro."@es .

<http://example.org/modcol/recurso/modismo/arrodillado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En un debate en el Congreso me dijeron: usted es un arrodillado a Estados Unidos por la política antidrogas."@es .

<http://example.org/modcol/recurso/modismo/arrozudo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrozudo/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que tiene la piel erizada como reacción a un hecho inesperado, o a la sensación de miedo o de frío."@es .

<http://example.org/modcol/recurso/modismo/arrozudo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me hizo emocionar de una manera que ni puedo explicar. Me puse arrozudo. Es más, me tuve que tomar dos brandys para controlar esta emoción tan grande."@es .

<http://example.org/modcol/recurso/modismo/arrozudo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrozudo/acepcion/2/ejemplo> ;
    skos:definition "que tiene la piel erizada por el frío, miedo u otra sensación"@es .

<http://example.org/modcol/recurso/modismo/arrozudo/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "me puse arrozudo y se me fueron los pulsos. esto no tiene remedio [ .]. es casi fijo que me van a empuntar para los infiernos"@es .

<http://example.org/modcol/recurso/modismo/arrugarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrugarse/acepcion/1/ejemplo> ;
    skos:definition "eludir un compromiso"@es .

<http://example.org/modcol/recurso/modismo/arrugarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "tenía que hablar, pero se arrugó al ver tanta gente"@es .

<http://example.org/modcol/recurso/modismo/arrugarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrugarse/acepcion/2/ejemplo> ;
    skos:definition "Desistir de hacer algo por temor."@es .

<http://example.org/modcol/recurso/modismo/arrugarse/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Fue un partido de mucho contacto, el equipo nunca se arrugó."@es .

<http://example.org/modcol/recurso/modismo/arrumar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrumar/acepcion/1/ejemplo> ;
    skos:definition "amontonar"@es .

<http://example.org/modcol/recurso/modismo/arrumar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "tiene arrumados los libros en una esquina"@es .

<http://example.org/modcol/recurso/modismo/arrumar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Ubicar objetos de poca utilidad en un lugar apartado para que no estorben."@es .

<http://example.org/modcol/recurso/modismo/arrumar/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrumar/acepcion/3/ejemplo> ;
    skos:definition "Poner cosas del mismo tipo en montones."@es .

<http://example.org/modcol/recurso/modismo/arrumar/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Estábamos arrumando bultos de café y yo me ponía a cantar mis números."@es .

<http://example.org/modcol/recurso/modismo/arrumbarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "oxidarse una vasija de cobre, soltar rumbo"@es .

<http://example.org/modcol/recurso/modismo/arrume/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrume/acepcion/1/ejemplo> ;
    skos:definition "Conjunto de cosas amontonadas."@es .

<http://example.org/modcol/recurso/modismo/arrume/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "A usted le corresponde hacerse cargo de la situación. (Le entrega el teléfono y un arrume de cartas)."@es .

<http://example.org/modcol/recurso/modismo/arrume/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrume/acepcion/2/ejemplo> ;
    skos:definition "pila, montón"@es .

<http://example.org/modcol/recurso/modismo/arrume/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "qué arrume de periódicos"@es .

<http://example.org/modcol/recurso/modismo/arruncharse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "encogerse para dormir, hacerse un ovillo"@es .

<http://example.org/modcol/recurso/modismo/arruncharse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arruncharse/acepcion/2/ejemplo> ;
    skos:definition "Dormir con el cuerpo encogido o muy abrazado a alguien."@es .

<http://example.org/modcol/recurso/modismo/arruncharse/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los psicólogos recomiendan a los matrimonios arruncharse y tener una charla romántica con la pareja."@es .

<http://example.org/modcol/recurso/modismo/arrunche/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrunche/acepcion/1/ejemplo> ;
    skos:definition "Demostración de afecto de una pareja en una cama o sofá, abrazándose y mimándose."@es .

<http://example.org/modcol/recurso/modismo/arrunche/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Uno es ese soporte para el músico cuando llega de tantos viajes, cansado, y necesita ese arrunche, ese apoyo en la casa."@es .

<http://example.org/modcol/recurso/modismo/arrutanao/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrutanao/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, fracasada."@es .

<http://example.org/modcol/recurso/modismo/arrutanao/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ha tenido intención de prescindir de los servicios del arrutanao, bochinchero y tosco personaje, pero no ha podido hacerlo."@es .

<http://example.org/modcol/recurso/modismo/arrutanao/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arrutanao/acepcion/2/ejemplo> ;
    skos:definition "Referido a una persona, que está arruinado."@es .

<http://example.org/modcol/recurso/modismo/arrutanao/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No creo que  acepten esa tarjeta de crédito, estoy arrutanao."@es .

<http://example.org/modcol/recurso/modismo/artillero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/artillero/acepcion/1/ejemplo> ;
    skos:definition "En el fútbol, jugador que anota muchos goles."@es .

<http://example.org/modcol/recurso/modismo/artillero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con ese gol fue catalogado como el máximo artillero del fútbol colombiano."@es .

<http://example.org/modcol/recurso/modismo/artista/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, engreída y vanidosa."@es .

<http://example.org/modcol/recurso/modismo/aruñar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/aruñar/acepcion/1/ejemplo> ;
    skos:definition "Lastimar la piel rasgándola con las uñas."@es .

<http://example.org/modcol/recurso/modismo/aruñar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Hay que cortarle la uñas a los bebés desde los primeros días de vida porque se pueden aruñar la cara con ellas."@es .

<http://example.org/modcol/recurso/modismo/aruñón/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/aruñón/acepcion/1/ejemplo> ;
    skos:definition "Herida superficial que se hace con las uñas o algún elemento puntiagudo."@es .

<http://example.org/modcol/recurso/modismo/aruñón/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si usted o uno de sus amigos o familiares es agredido con el aruñón de un felino, el primer paso que se debe realizar es lavar la herida."@es .

<http://example.org/modcol/recurso/modismo/asadero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Restaurante en el que se vende pollo o carnes a la brasa."@es .

<http://example.org/modcol/recurso/modismo/asado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que está enojada, furiosa."@es .

<http://example.org/modcol/recurso/modismo/asado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ese tipo llegó todo asado y me insultó."@es .

<http://example.org/modcol/recurso/modismo/asado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asado/acepcion/2/ejemplo> ;
    skos:definition "Reunión en campo abierto en la que se prepara y se come carne y otros alimentos asados."@es .

<http://example.org/modcol/recurso/modismo/asado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Algunos prefieren celebrar el día del amor y la amistad reuniéndose con sus amigos para comprar carne, papas y cerveza y hacer un asado en la terraza de una casa."@es .

<http://example.org/modcol/recurso/modismo/asaltacunas/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Persona que suele seducir a otra más joven."@es .

<http://example.org/modcol/recurso/modismo/asentar-los-cascos/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asentar-los-cascos/acepcion/1/ejemplo> ;
    skos:definition "adquirir seriedad y juicio"@es .

<http://example.org/modcol/recurso/modismo/asentar-los-cascos/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "estos enredos de la chatica [ .] son ardores de la mocedad, aunque algo anticipados. ahí se le irán pasando, a conforme vaya asentando los cascos"@es .

<http://example.org/modcol/recurso/modismo/asentarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asentarse/acepcion/1/ejemplo> ;
    skos:definition "ajuiciarse"@es .

<http://example.org/modcol/recurso/modismo/asentarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "pueda ser que nicanor se asiente con el casamiento"@es .

<http://example.org/modcol/recurso/modismo/aserruchar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "cortar con serrucho"@es .

<http://example.org/modcol/recurso/modismo/aserrío/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "aserradero"@es .

<http://example.org/modcol/recurso/modismo/asistencia/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "establecimiento público donde se sirven comidas"@es .

<http://example.org/modcol/recurso/modismo/asistir/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asistir/acepcion/1/ejemplo> ;
    skos:definition "residir, habitar"@es .

<http://example.org/modcol/recurso/modismo/asistir/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "eusebio asiste en la montaña"@es .

<http://example.org/modcol/recurso/modismo/asocio/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asocio/acepcion/1/ejemplo> ;
    skos:definition "En compañía de."@es .

<http://example.org/modcol/recurso/modismo/asocio/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La Secretaría de Salud en asocio con el Sena capacitó al personal que labora en el sector de la belleza."@es .

<http://example.org/modcol/recurso/modismo/asolapado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asolapado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que esconde sus actos y pensamientos."@es .

<http://example.org/modcol/recurso/modismo/asolapado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Si me dices la verdad, dejaré de pensar que eres un asolapado y podremos tener una buena relación."@es .

<http://example.org/modcol/recurso/modismo/asoleada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asoleada/acepcion/1/ejemplo> ;
    skos:definition "Exposición al sol por un tiempo prolongado."@es .

<http://example.org/modcol/recurso/modismo/asoleada/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con el tiempo, el bronceado inevitablemente desaparecerá, aunque una asoleada de vez en cuando puede ayudar a que no se borren del todo las huellas."@es .

<http://example.org/modcol/recurso/modismo/asolear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asolear/acepcion/1/ejemplo> ;
    skos:definition "Tomar el sol."@es .

<http://example.org/modcol/recurso/modismo/asolear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tampoco los señores caleños se perdían los mediodías en el hotel donde ella se asoleaba sin meterse al agua porque nunca aprendió a nadar."@es .

<http://example.org/modcol/recurso/modismo/asolear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asolear/acepcion/2/ejemplo> ;
    skos:definition "Presionar o causar molestia a alguien."@es .

<http://example.org/modcol/recurso/modismo/asolear/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Todas las mañanas lo asoleaba con preguntas sobre los informes que aún no tenía listos."@es .

<http://example.org/modcol/recurso/modismo/asomadera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asomadera/acepcion/1/ejemplo> ;
    skos:definition "Acción reiterada de asomarse a un balcón, una ventana o una puerta para contemplar algo."@es .

<http://example.org/modcol/recurso/modismo/asomadera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La señora se pone de unos nervios de manicomio, no pega el ojo ni un ratico y le cae una asomadera peor que la del comercial de la televisión, ¿qué hacemos?."@es .

<http://example.org/modcol/recurso/modismo/aspavientero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Referido a una persona, que hace demostraciones exageradas de sus sentimientos."@es .

<http://example.org/modcol/recurso/modismo/asquiento/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asquiento/acepcion/1/ejemplo> ;
    skos:definition "dicho de una persona, que es propensa a tener asco"@es .

<http://example.org/modcol/recurso/modismo/asquiento/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "se me apaga el tabaco y me dan ansias"@es .

<http://example.org/modcol/recurso/modismo/asquiento/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/asquiento/acepcion/2/ejemplo> ;
    skos:definition "Referido a una persona, que es propensa o siente asco o repugnancia por algo en exceso."@es .

<http://example.org/modcol/recurso/modismo/asquiento/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En una entrevista dijo que era muy asquiento y que si en una fiesta le daba la mano a mucha gente, luego no sabía qué hacer con ella."@es .

<http://example.org/modcol/recurso/modismo/asustada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "susto"@es .

<http://example.org/modcol/recurso/modismo/atacado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atacado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que actúa con precipitud, impaciencia."@es .

<http://example.org/modcol/recurso/modismo/atacado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No seas atacada, deja que el jefe se calme y luego le hablas de tu aumento."@es .

<http://example.org/modcol/recurso/modismo/atacarse-de-la-risa/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atacarse-de-la-risa/acepcion/1/ejemplo> ;
    skos:definition "Reírse desmedida y escandalosamente."@es .

<http://example.org/modcol/recurso/modismo/atacarse-de-la-risa/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Somos una 'modern family' (vuelve a atacarse de la risa)."@es .

<http://example.org/modcol/recurso/modismo/atacuñar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "embutirse uno de alimentos"@es .

<http://example.org/modcol/recurso/modismo/atacuñar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "rellenar un hueco o espacio vacío"@es .

<http://example.org/modcol/recurso/modismo/atado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Provisión de comida que se lleva para consumir en las faenas del campo o en un viaje."@es .

<http://example.org/modcol/recurso/modismo/atafagar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atafagar/acepcion/1/ejemplo> ;
    skos:definition "Sentir angustia por exceso de trabajo excesivo o por carencia de tiempo."@es .

<http://example.org/modcol/recurso/modismo/atafagar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ese día ella depositó en sus oídos la lista que la atafagaba desde su llegada a Springfield y que no había podido compartir con nadie."@es .

<http://example.org/modcol/recurso/modismo/atajada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atajada/acepcion/1/ejemplo> ;
    skos:definition "En fútbol y otros deportes, detención o desvío del balón lanzado por otro jugador, para evitar que se introduzca en la portería."@es .

<http://example.org/modcol/recurso/modismo/atajada/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Los expertos califican la atajada del jugador como una de las mejores de la temporada."@es .

<http://example.org/modcol/recurso/modismo/atajar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atajar/acepcion/1/ejemplo> ;
    skos:definition "En fútbol y otros deportes, detener o desviar el balón lanzado por otro jugador, para evitar que se introduzca en la portería."@es .

<http://example.org/modcol/recurso/modismo/atajar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Su cobro fue suave a la derecha del arquero cartagenero quien le adivinó el remate y atajó el balón."@es .

<http://example.org/modcol/recurso/modismo/atalayero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atalayero/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, maleducada e inculta."@es .

<http://example.org/modcol/recurso/modismo/atalayero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Es una atalayera que siempre dice y hace lo que le da la gana, sin importarle nada ni nadie."@es .

<http://example.org/modcol/recurso/modismo/ataque/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/ataque/acepcion/1/ejemplo> ;
    skos:definition "Estupendo o extraordinario."@es .

<http://example.org/modcol/recurso/modismo/ataque/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tu fiesta de cumpleaños estuvo de ataque, con comida, bebida y buena música."@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarantado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, distraída, no presta atención de lo que pasa en su entorno."@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Este atarantado nunca coge la ruta correcta del bus, siempre resulta al otro extremo de la ciudad."@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarantado/acepcion/2/ejemplo> ;
    skos:definition "Referido a una persona, que toma decisiones a la ligera y no reflexiona sobre una situación."@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Deje de ser atarantado, piense antes de actuar y así no tendrá problemas."@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarantado/acepcion/3/ejemplo> ;
    skos:definition "Tonto, que actúa con poca inteligencia o poco entendimiento."@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Y tanto atarantado que anda por ahí comiendo crispetas y patiando latas de cerveza vacías, le come cuento y repite: sííí, ¡crucifíquenlas!"@es .

<http://example.org/modcol/recurso/modismo/atarantado/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "que obra con precipitud o falta de reflexión"@es .

<http://example.org/modcol/recurso/modismo/atarantarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "precipitarse a hacer las cosas sin reflexión"@es .

<http://example.org/modcol/recurso/modismo/atarantarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarantarse/acepcion/2/ejemplo> ;
    skos:definition "Apresurarse a hacer algo sin pensar en sus consecuencias."@es .

<http://example.org/modcol/recurso/modismo/atarantarse/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Aquí nadie debe atarantarse que no va a haber despidos ni sanciones para nadie […] el presidente entrega sus disculpas y no ha pasado nada."@es .

<http://example.org/modcol/recurso/modismo/atarragarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarragarse/acepcion/1/ejemplo> ;
    skos:definition "Comer en exceso."@es .

<http://example.org/modcol/recurso/modismo/atarragarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Enojado gritaba que las comilonas se habían acabado, que la gente ya se había atarragado y que ante la crisis debían apretarse el cinturón."@es .

<http://example.org/modcol/recurso/modismo/atarragarse/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "comer en exceso"@es .

<http://example.org/modcol/recurso/modismo/atarraya/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarraya/acepcion/1/ejemplo> ;
    skos:definition "Red de pesca que tiene forma redonda y se usa en los ríos y parajes de poco fondo."@es .

<http://example.org/modcol/recurso/modismo/atarraya/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El pescador / Habla con la luna /El pescador / Habla con la playa /El pescador /No tiene fortuna / Sólo su atarraya (bis)."@es .

<http://example.org/modcol/recurso/modismo/atarrayar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "pescar con atarraya"@es .

<http://example.org/modcol/recurso/modismo/atarrosarse/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarrosarse/acepcion/1/ejemplo> ;
    skos:definition "Confundirse o sorprenderse ante algo inesperado."@es .

<http://example.org/modcol/recurso/modismo/atarrosarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me atarrosó que la res le hubiera pegado esa patada tan terrible... ¡Si es muy mancita!"@es .

<http://example.org/modcol/recurso/modismo/atarván/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "grosero, insolente, agresivo"@es .

<http://example.org/modcol/recurso/modismo/atarván/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarván/acepcion/2/ejemplo> ;
    skos:definition "Persona grosera, agresiva y de modales toscos."@es .

<http://example.org/modcol/recurso/modismo/atarván/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Lo fuimos perdiendo de vista y aunque lo seguíamos considerando un bacán a veces pensábamos que se había vuelto demasiado atarván."@es .

<http://example.org/modcol/recurso/modismo/atarzanar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarzanar/acepcion/1/ejemplo> ;
    skos:definition "Presionar o abrumar a alguien para que haga algo."@es .

<http://example.org/modcol/recurso/modismo/atarzanar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pedro no supo responder con estadísticas en mano, argumentando que no sabía que lo iban a “atarzanar”."@es .

<http://example.org/modcol/recurso/modismo/atarzanar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atarzanar/acepcion/2/ejemplo> ;
    skos:definition "Abrazar fuertemente a alguien."@es .

<http://example.org/modcol/recurso/modismo/atarzanar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Para atarzanar a una pipiola había que sacarla a bailar bolero en alguna rumba sabatina con los ojos de la suegra respirándonos en la nuca."@es .

<http://example.org/modcol/recurso/modismo/ataviar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/ataviar/acepcion/1/ejemplo> ;
    skos:definition "Portar grandes cantidades de algo."@es .

<http://example.org/modcol/recurso/modismo/ataviar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El abuelo va súper ataviado de regalos y juguetes para los nietos que se va a visitar."@es .

<http://example.org/modcol/recurso/modismo/ataúd-de-las-ánimas/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/ataúd-de-las-ánimas/acepcion/1/ejemplo> ;
    skos:definition "féretro de madera tosca, sin pulimento ni pintura, que se emplea en los pueblos para enterrar a los pobres de solemnidad"@es .

<http://example.org/modcol/recurso/modismo/ataúd-de-las-ánimas/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "salieron los comisarios con el ataúd de las ánimas"@es .

<http://example.org/modcol/recurso/modismo/atembado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "dicho de una persona, atolondrada, atontada"@es .

<http://example.org/modcol/recurso/modismo/atembado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/atembado/acepcion/2/ejemplo> ;
    skos:definition "Tonto, que actúa con poca inteligencia o poco entendimiento."@es .

<http://example.org/modcol/recurso/modismo/atembado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Pero este se hizo el atembado sacando a relucir las poco creíbles estadísticas de Vallenpaz."@es .

<http://example.org/modcol/recurso/modismo/atembar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
