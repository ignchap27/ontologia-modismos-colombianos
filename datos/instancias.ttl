<http://example.org/modcol/recurso/modismo/atorarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No le encontraba gusto a las cosas, hasta la comida se me atoraba."@es .

<http://example.org/modcol/recurso/modismo/atortolado/acepcion/1> a mc:Acepcion ;
