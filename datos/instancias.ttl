    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Cigarrillo sin filtro que se fuma con el extremo encendido dentro de la boca."@es .

<http://example.org/modcol/recurso/modismo/calado/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
