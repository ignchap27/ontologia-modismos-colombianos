<http://example.org/modcol/recurso/modismo/baldosa/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Caleños y turistas de otras ciudades y países empezaron a ‘azotar baldosa’ con las clases que especialistas en la materia realizan esta semana."@es .

<http://example.org/modcol/recurso/modismo/baldío/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
