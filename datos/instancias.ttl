<http://example.org/modcol/recurso/modismo/cábano/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Ya probaste los jamones, los chorizos, los cábanos, el queso de cabeza y demás?"@es .

<http://example.org/modcol/recurso/modismo/cáscara/acepcion/1> a mc:Acepcion ;
