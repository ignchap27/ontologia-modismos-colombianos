<http://example.org/modcol/recurso/modismo/mugre/acepcion/4/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "No sea mugre, ayúdele a cargar las maletas."@es .

<http://example.org/modcol/recurso/modismo/mujervieja/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/mujervieja/acepcion/1/ejemplo> ;
