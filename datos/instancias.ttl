<http://example.org/modcol/recurso/modismo/lapo/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Es que yo volvería a votar por ese alcalde a ojo cerrado: físicamente es un lapo de hombre."@es .

<http://example.org/modcol/recurso/modismo/lapo/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/lapo/acepcion/3/ejemplo> ;
