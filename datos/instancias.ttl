<http://example.org/modcol/recurso/modismo/moscorrofio/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Palmirano y visitante que se respete no puede dejar de comer el moscorrofio, caspiroletas, suspiros, polvorosas, galletas de anís, pandebono."@es .

<http://example.org/modcol/recurso/modismo/moscorrofio/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
