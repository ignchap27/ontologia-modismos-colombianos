    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/liso/acepcion/3/ejemplo> ;
    skos:definition "Referido a una persona, atrevida, confianzuda."@es .

<http://example.org/modcol/recurso/modismo/liso/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En verbenas y casetas todavía se escucha eso de “saca la mano liso que ese man te va a cascar”."@es .

<http://example.org/modcol/recurso/modismo/lisura/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "expresión procaz"@es .

<http://example.org/modcol/recurso/modismo/lisura/acepcion/2> a mc:Acepcion ;
