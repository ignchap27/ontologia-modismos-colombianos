<http://example.org/modcol/recurso/modismo/intenso/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "no sea tan intenso"@es .

<http://example.org/modcol/recurso/modismo/intenso/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
