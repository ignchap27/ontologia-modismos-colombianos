<http://example.org/modcol/recurso/modismo/empajar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Su madre estaba tan llena de cosas por decirle, que un buen día lo sentó en la cocina y lo empajó, después se sintió aliviada."@es .

<http://example.org/modcol/recurso/modismo/empajar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empajar/acepcion/2/ejemplo> ;
    skos:definition "Reprender, regañar severamente a alguien."@es .

<http://example.org/modcol/recurso/modismo/empajar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Tuve cautivao unos días, pero lo supo el hombre y me empajó."@es .

<http://example.org/modcol/recurso/modismo/empajar/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
