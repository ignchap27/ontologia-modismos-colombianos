<http://example.org/modcol/recurso/modismo/arremuesco/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Desde que anda con ese arremuesco, descuidó el estudio."@es .

<http://example.org/modcol/recurso/modismo/arremuesco/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/arremuesco/acepcion/3/ejemplo> ;
    skos:definition "Persona, especialmente un niño, que molesta mucho."@es .

<http://example.org/modcol/recurso/modismo/arremuesco/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Está insoportable este arremuesco, le gritó la mamá."@es .

<http://example.org/modcol/recurso/modismo/arreo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
