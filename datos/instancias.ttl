    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/carameliar/acepcion/1/ejemplo> ;
    skos:definition "dilatar engañosamente la solución de un asunto"@es .

<http://example.org/modcol/recurso/modismo/carameliar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "el gerente me caramelió para aprobarme el préstamo"@es .

<http://example.org/modcol/recurso/modismo/caramelita/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
