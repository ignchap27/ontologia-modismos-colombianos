    skos:definition "Hacerle perder un profesor a un estudiante, una materia."@es .

<http://example.org/modcol/recurso/modismo/enyardar/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Eche, ese profesor como que me tiene cola porque me enyardó en el examen."@es .

<http://example.org/modcol/recurso/modismo/enyesar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enyesar/acepcion/1/ejemplo> ;
