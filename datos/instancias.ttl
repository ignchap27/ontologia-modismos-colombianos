    mc:textoEjemplo "Se compro un gallo fino papujo que en verdad parecía un león cuando peleaba."@es .

<http://example.org/modcol/recurso/modismo/papujo/acepcion/4> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/papujo/acepcion/4/ejemplo> ;
