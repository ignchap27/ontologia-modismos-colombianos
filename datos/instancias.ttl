    skos:definition "beber con avidez y sin detenerse"@es .

<http://example.org/modcol/recurso/modismo/bogar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "pacho está bogando en la tienda desde la una. se lo bogó de una"@es .

