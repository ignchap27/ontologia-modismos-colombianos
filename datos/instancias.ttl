<http://example.org/modcol/recurso/modismo/tío/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "!Buenos dias el tío! veníamos a preguntarle una cosita a mi tío."@es .

<http://example.org/modcol/recurso/modismo/tórtolo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Pene."@es .

<http://example.org/modcol/recurso/modismo/tóxico/acepcion/1> a mc:Acepcion ;
