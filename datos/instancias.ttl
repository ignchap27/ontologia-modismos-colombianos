<http://example.org/modcol/recurso/modismo/paz-y-salvo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Como estás próximo a graduarte es necesario que cumplas con unos requisitos mínimos que acrediten que estás a paz y salvo con diferentes áreas de la universidad."@es .

<http://example.org/modcol/recurso/modismo/paz-y-salvo/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "certificado oficial en el que se afirma que una persona no debe o no adeuda nada al estado por concepto de impuestos"@es .

<http://example.org/modcol/recurso/modismo/paz-y-salvo/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/paz-y-salvo/acepcion/3/ejemplo> ;
    skos:definition "Certificado que demuestra que se pagó una deuda."@es .

<http://example.org/modcol/recurso/modismo/paz-y-salvo/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "A través de nuestro sistema en línea usted podrá consultar su estado de cuenta y de este modo generar su paz y salvo virtual."@es .

<http://example.org/modcol/recurso/modismo/pañalera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
