<http://example.org/modcol/recurso/modismo/chucha/acepcion/6> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/chucha/acepcion/6/ejemplo> ;
