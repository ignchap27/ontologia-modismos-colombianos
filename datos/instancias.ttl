    skos:definition "Harina extraída de la desecación y maceración de la raíz de esta planta."@es .

<http://example.org/modcol/recurso/modismo/sahumerio/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/sahumerio/acepcion/1/ejemplo> ;
    skos:definition "Limpieza del ambiente de una casa que consiste en la quema de sustancias aromáticas, con fines depurativos o rituales."@es .

<http://example.org/modcol/recurso/modismo/sahumerio/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ahí asoma la negra: trae el braserillo de plata con el sahumerio de incienso y alcanfor a fin de perfumar el aposento."@es .

<http://example.org/modcol/recurso/modismo/salado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salado/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, que tiene mala suerte."@es .

<http://example.org/modcol/recurso/modismo/salado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Como lo convencieron de que estaba salado visitó a varias pitonisas para que lo abandonara su mala fortuna."@es .

<http://example.org/modcol/recurso/modismo/salado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salado/acepcion/2/ejemplo> ;
    skos:definition "dicho de una persona, que tiene mala suerte"@es .

<http://example.org/modcol/recurso/modismo/salado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "estamos salados, no hemos ganado ningún partido"@es .

<http://example.org/modcol/recurso/modismo/salar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "tener o dar mala suerte"@es .

<http://example.org/modcol/recurso/modismo/salar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salar/acepcion/2/ejemplo> ;
    skos:definition "Causar perjuicio o mala suerte a alguien."@es .

<http://example.org/modcol/recurso/modismo/salar/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Entre los tahúres lanzar los dados con la mano izquierda sala al jugador de por vida."@es .

<http://example.org/modcol/recurso/modismo/salar/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Dar de comer sal al ganado."@es .

<http://example.org/modcol/recurso/modismo/salida/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/salida/acepcion/1/ejemplo> ;
    skos:definition "Estar en una situación muy complicada."@es .

<http://example.org/modcol/recurso/modismo/salida/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Con berraquera salieron adelante los jóvenes que estaban en la sin salida con la droga."@es .

<http://example.org/modcol/recurso/modismo/salidera/acepcion/1> a mc:Acepcion ;
