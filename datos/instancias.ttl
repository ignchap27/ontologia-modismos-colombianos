    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/mundial/acepcion/1/ejemplo> ;
    skos:definition "Referido a algo, extraordinario."@es .

