<http://example.org/modcol/recurso/modismo/cutucutu/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¿Cómo se te ocurre que voy a saltar así no más? Me da cutucutu."@es .

<http://example.org/modcol/recurso/modismo/cuyabra/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cuyabra/acepcion/1/ejemplo> ;
