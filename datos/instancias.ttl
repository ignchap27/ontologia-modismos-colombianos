<http://example.org/modcol/recurso/modismo/baldado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El Ice Bucket Challenge, que consistía en ‘echarse’ un baldado de agua fría en la cabeza, fue creado por un estadounidense afectado por la esclerosis."@es .

<http://example.org/modcol/recurso/modismo/baldosa/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
