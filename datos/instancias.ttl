<http://example.org/modcol/recurso/modismo/marear/acepcion/3/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Había prometido comprarnos la casa, pero yo creo que se mareó, dos meses y no ha llamado."@es .

<http://example.org/modcol/recurso/modismo/mariapalito/acepcion/1> a mc:Acepcion ;
