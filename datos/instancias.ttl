<http://example.org/modcol/recurso/modismo/puya/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El Carnaval de Barranquilla es un festival mestizo, amenizado por los ritmos de la cumbia, el porro, la puya y el merecumbé."@es .

<http://example.org/modcol/recurso/modismo/puyar/acepcion/1> a mc:Acepcion ;
