<http://example.org/modcol/recurso/modismo/carreta/acepcion/7/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "la carreta de los sociólogos, de los abogados, etc"@es .

<http://example.org/modcol/recurso/modismo/carreteable/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
