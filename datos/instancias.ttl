<http://example.org/modcol/recurso/modismo/enculebrado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "desde que quedó sin trabajo está muy enculebrado"@es .

<http://example.org/modcol/recurso/modismo/enculebrado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
