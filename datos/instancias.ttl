<http://example.org/modcol/recurso/modismo/papelero/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "no le creas que está enferma porque es muy papelera"@es .

<http://example.org/modcol/recurso/modismo/papeleta/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/papeleta/acepcion/1/ejemplo> ;
