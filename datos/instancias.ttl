<http://example.org/modcol/recurso/modismo/raya/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Te decidiste a tener mascota! dónde hago la raya."@es .

<http://example.org/modcol/recurso/modismo/rayado/acepcion/1> a mc:Acepcion ;
