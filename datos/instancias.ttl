<http://example.org/modcol/recurso/modismo/cantina/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cantina/acepcion/2/ejemplo> ;
    skos:definition "Recipiente metálico en el que se transporta la leche."@es .

<http://example.org/modcol/recurso/modismo/cantina/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Viví la época en la que la leche llegaba a la puerta de mi casa, aún caliente, con el sabor del ordeño, reenvasada de una cantina."@es .

<http://example.org/modcol/recurso/modismo/cantina/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
