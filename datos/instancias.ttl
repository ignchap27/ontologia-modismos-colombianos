<http://example.org/modcol/recurso/modismo/cantarilla/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El Colegio realizó el sorteo de su tradicional cantarilla este mes en el marco de la entrega del segundo informe escrito del año."@es .

<http://example.org/modcol/recurso/modismo/cantarilla/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
