    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/escampadero/acepcion/1/ejemplo> ;
    skos:definition "Lugar o empleo provisional que se toma mientras se espera otro."@es .

<http://example.org/modcol/recurso/modismo/escampadero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
