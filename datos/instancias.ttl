<http://example.org/modcol/recurso/modismo/embaldosinado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Mañana empiezan con el embaldosinado del baño."@es .

<http://example.org/modcol/recurso/modismo/embaldosinar/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/embaldosinar/acepcion/1/ejemplo> ;
