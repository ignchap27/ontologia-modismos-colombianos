<http://example.org/modcol/recurso/modismo/morona/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "la porcelana quedó hecha boronas"@es .

<http://example.org/modcol/recurso/modismo/morrocota/acepcion/1> a mc:Acepcion ;
