<http://example.org/modcol/recurso/modismo/parranda/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Había una parranda de gente esperando en la calle a que llegara su artista favorito."@es .

<http://example.org/modcol/recurso/modismo/parrando/acepcion/1> a mc:Acepcion ;
