<http://example.org/modcol/recurso/modismo/papelógrafo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En la sala de juntas se encuentra un escritorio, un computador, papel, lápices, papelógrafo e, incluso, teléfono celular."@es .

<http://example.org/modcol/recurso/modismo/papero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/papero/acepcion/1/ejemplo> ;
