<http://example.org/modcol/recurso/modismo/joder/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me gusta joderlo para que se ría un poco."@es .

<http://example.org/modcol/recurso/modismo/jodido/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
