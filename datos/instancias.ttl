<http://example.org/modcol/recurso/modismo/cebado/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/cebado/acepcion/2/ejemplo> ;
    skos:definition "Referido a un animal salvaje, que se ha habituado a atacar a las personas por haber probado carne humana."@es .

<http://example.org/modcol/recurso/modismo/cebado/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Soy un hombre del común, uno más de los sin nombre, hasta que mi madre me encuentre en esta tierra de caimanes cebados de indefensión, en esta tierra de caimanes cebados de hombre."@es .

<http://example.org/modcol/recurso/modismo/cedulación/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
