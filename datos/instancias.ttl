<http://example.org/modcol/recurso/modismo/jojoro/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "el maíz no sirve, está jojoro"@es .

<http://example.org/modcol/recurso/modismo/jojoto/acepcion/1> a mc:Acepcion ;
