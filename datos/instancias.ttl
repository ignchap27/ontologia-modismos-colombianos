<http://example.org/modcol/recurso/modismo/palabra/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Palabra soez."@es .

<http://example.org/modcol/recurso/modismo/palabra/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Acaparar el uso de la palabra en una conversación sin dejar hablar a los otros participantes."@es .

<http://example.org/modcol/recurso/modismo/palabrear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palabrear/acepcion/1/ejemplo> ;
    skos:definition "Acordar oralmente algo, pero sin formalizarlo."@es .

<http://example.org/modcol/recurso/modismo/palabrear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Ayer solo palabrearon el contrato de arrendamiento, mañana lo firman."@es .

<http://example.org/modcol/recurso/modismo/palabrero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palabrero/acepcion/1/ejemplo> ;
    skos:definition "Persona que media y concilia en los conflictos interfamiliares de los wayúu, grupo étnico del departamento de La Guajira."@es .

<http://example.org/modcol/recurso/modismo/palabrero/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El palabrero lleva la palabra de paz y respeto, la palabra que puede enderezar el curso de los caminos desviados."@es .

<http://example.org/modcol/recurso/modismo/paladear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/paladear/acepcion/1/ejemplo> ;
    skos:definition "Tratar con mimos y condescendencia a alguien."@es .

<http://example.org/modcol/recurso/modismo/paladear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Yo defendía a las niñas aunque se portaran pésimo. Yo las paladeaba, las consentía, les hablaba con voz suavecita, como pidiéndoles perdón."@es .

<http://example.org/modcol/recurso/modismo/paladear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Darle de comer a un niño o a un enfermo."@es .

<http://example.org/modcol/recurso/modismo/palanca/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palanca/acepcion/1/ejemplo> ;
    skos:definition "persona cuya intervención o influencia se utiliza para obtener algo"@es .

<http://example.org/modcol/recurso/modismo/palanca/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "tiene muchas palancas en el gobierno"@es .

<http://example.org/modcol/recurso/modismo/palanca/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palanca/acepcion/2/ejemplo> ;
    skos:definition "Recomendación o influencia por la que se obtiene un beneficio, especialmente un empleo, sin que sea solo por mérito propio."@es .

<http://example.org/modcol/recurso/modismo/palanca/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Esto es lo que pasa en este país, el que no tiene palanca difícilmente logra al menos una entrevista de trabajo."@es .

<http://example.org/modcol/recurso/modismo/palanquear/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palanquear/acepcion/1/ejemplo> ;
    skos:definition "Valerse de alguien influyente para obtener un beneficio, especialmente un empleo."@es .

<http://example.org/modcol/recurso/modismo/palanquear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me tocó palanquear la cita con el gerente de atención médica."@es .

<http://example.org/modcol/recurso/modismo/palanquear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "interceder con poder o influencia para lograr algún fin, por ejemplo, conseguirle empleo a alguien, cupo en un plantel escolar, etc"@es .

<http://example.org/modcol/recurso/modismo/palenque/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palenque/acepcion/1/ejemplo> ;
    skos:definition "Lugar de difícil acceso y alejados protegidos por fortificaciones en forma de empalizadas que servía de refugio a los esclavos fugitivos."@es .

<http://example.org/modcol/recurso/modismo/palenque/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "De los muchos palenques que existían en épocas anteriores, sólo el de San Basilio ha sobrevivido hasta hoy, convirtiéndose en un espacio cultural único."@es .

<http://example.org/modcol/recurso/modismo/palera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palera/acepcion/1/ejemplo> ;
    skos:definition "Serie de golpes dados a una persona o a un animal a modo de castigo."@es .

<http://example.org/modcol/recurso/modismo/palera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Se había robado dos ollas de aluminio, las mismas que dejó en el piso por la palera que le dieron."@es .

<http://example.org/modcol/recurso/modismo/palera/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palera/acepcion/2/ejemplo> ;
    skos:definition "En una competencia deportiva, derrota contundente."@es .

<http://example.org/modcol/recurso/modismo/palera/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Les vamos a dar una palera!, era la frase que se oía por las calles porque nadie dudaba de un triunfo aplastante del equipo."@es .

<http://example.org/modcol/recurso/modismo/paleta/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/paleta/acepcion/1/ejemplo> ;
    skos:definition "Helado compacto en forma de pala, sostenido por un palito de madera o de plástico."@es .

<http://example.org/modcol/recurso/modismo/paleta/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Repartía mercancía en triciclo. Vendía gaseosas, buñuelos, helados, paletas, cocadas."@es .

<http://example.org/modcol/recurso/modismo/paleta/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "helado en forma de pala, que se chupa cogiéndolo por un manguito de madera"@es .

<http://example.org/modcol/recurso/modismo/paliadera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/paliadera/acepcion/1/ejemplo> ;
    skos:definition "Patio trasero de una casa que se eleva sobre el suelo, normalmente apoyada en estacas de madera."@es .

<http://example.org/modcol/recurso/modismo/paliadera/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Me estaba bañando, manito, en la paliadera/ y oía que qritaban, manito, ahí va la culebra"@es .

<http://example.org/modcol/recurso/modismo/palito/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palito/acepcion/1/ejemplo> ;
    skos:definition "Trago de licor, especialmente de ron."@es .

<http://example.org/modcol/recurso/modismo/palito/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Uno se echa un palito entonces como que se le calientan los pies a uno para bailar."@es .

<http://example.org/modcol/recurso/modismo/palitraquero/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/palitraquero/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, embustera, tramposa."@es .

