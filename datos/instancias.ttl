    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/escamoso/acepcion/1/ejemplo> ;
    skos:definition "Dicho de una persona, que fanfarronea o que presume."@es .

<http://example.org/modcol/recurso/modismo/escamoso/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El remitente de las carticas sutiles no podía ser otro que el tipo escamoso que ahora la saludaba."@es .

<http://example.org/modcol/recurso/modismo/escampadero/acepcion/1> a mc:Acepcion ;
