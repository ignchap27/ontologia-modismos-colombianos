<http://example.org/modcol/recurso/modismo/carraquear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Venía completamente empapado y carraqueando del frío."@es .

<http://example.org/modcol/recurso/modismo/carraquear/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/carraquear/acepcion/2/ejemplo> ;
