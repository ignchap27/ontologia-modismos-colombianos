<http://example.org/modcol/recurso/modismo/empandorgarse/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "cuide de que el negocio no se vaya a empandorgar"@es .

<http://example.org/modcol/recurso/modismo/empanicado/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/empanicado/acepcion/1/ejemplo> ;
