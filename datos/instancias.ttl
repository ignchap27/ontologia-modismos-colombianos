<http://example.org/modcol/recurso/modismo/enyardar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Eso no se queda así; te voy a enyardar."@es .

<http://example.org/modcol/recurso/modismo/enyardar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/enyardar/acepcion/2/ejemplo> ;
