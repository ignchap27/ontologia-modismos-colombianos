<http://example.org/modcol/recurso/modismo/cajulo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Y apena yega argún cajulo se le avienta pa que le compre a ella sola su comira babosiáa."@es .

<http://example.org/modcol/recurso/modismo/cajón/acepcion/1> a mc:Acepcion ;
