<http://example.org/modcol/recurso/modismo/pañetar/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Desde pequeña se le midió a oficios de hombre en la casa, entre ellos, arreglar la tubería, pañetar las paredes y pintar."@es .

<http://example.org/modcol/recurso/modismo/pañetar/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
