    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/mogote/acepcion/1/ejemplo> ;
    skos:definition "pequeña prominencia de tierra cubierta de césped, por lo general de forma cónica"@es .

<http://example.org/modcol/recurso/modismo/mogote/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "anoche dormí en l'arena,/ de cabecera un mogote;/¡cómo me estarán pensando/las mocitas de tribote"@es .

<http://example.org/modcol/recurso/modismo/moguiñudo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/moguiñudo/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, descuidada en su aseo personal y apariencia."@es .

<http://example.org/modcol/recurso/modismo/moguiñudo/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Estábamos hablando cuando pasó un moguiñudo que olía muy mal."@es .

<http://example.org/modcol/recurso/modismo/mohosearse/acepcion/1> a mc:Acepcion ;
