<http://example.org/modcol/recurso/modismo/mulera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/mulera/acepcion/1/ejemplo> ;
