<http://example.org/modcol/recurso/modismo/papeleta/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Contaron que todos se fueron acalorando y que la dueña del bar, que es una papeleta, reventó como un tote y sacó a todo el mundo."@es .

<http://example.org/modcol/recurso/modismo/papelógrafo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/papelógrafo/acepcion/1/ejemplo> ;
