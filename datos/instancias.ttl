<http://example.org/modcol/recurso/modismo/soco/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/soco/acepcion/1/ejemplo> ;
    skos:definition "Referido a una persona, escasa de entendimiento."@es .

<http://example.org/modcol/recurso/modismo/soco/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "¡Ese es mucho soco. Se pasó el semáforo en rojo y todavía alega!"@es .

<http://example.org/modcol/recurso/modismo/soco/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/soco/acepcion/2/ejemplo> ;
    skos:definition "Machete corto, viejo y desgastado."@es .

<http://example.org/modcol/recurso/modismo/soco/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Que vaina dijo Dios cuando se le perdió el soco."@es .

<http://example.org/modcol/recurso/modismo/soco/acepcion/3> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/soco/acepcion/3/ejemplo> ;
