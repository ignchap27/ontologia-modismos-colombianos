<http://example.org/modcol/recurso/modismo/colmena/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/colmena/acepcion/1/ejemplo> ;
    skos:definition "En un mercado, cada una de las casetas de los vendedores."@es .

<http://example.org/modcol/recurso/modismo/colmena/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En la actualidad el mercado mide 19 mil metros cuadrados y posee 510 colmenas de material."@es .

<http://example.org/modcol/recurso/modismo/color/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Condimento en polvo elaborado con la mezcla de diversas especias, y que se usa para dar un color amarillo rojizo a las preparaciones."@es .

<http://example.org/modcol/recurso/modismo/color/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/color/acepcion/2/ejemplo> ;
    skos:definition "Lápiz de color."@es .

<http://example.org/modcol/recurso/modismo/color/acepcion/2/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Para trabajar la crayola y los colores con niños de 3 a 4 años es recomendable que estos sean gruesos y triangulares."@es .

<http://example.org/modcol/recurso/modismo/colorete/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/colorete/acepcion/1/ejemplo> ;
    skos:definition "Cosmético usado para pintar los labios en forma de barra y protegido por un estuche generalmente cilíndrico y con tapa."@es .

<http://example.org/modcol/recurso/modismo/colorete/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Hemos fumado colillas de cigarrillos en los escupideros de los teatros, prefiriendo los de boquilla y los nimbados de colorete."@es .

<http://example.org/modcol/recurso/modismo/colorinche/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/colorinche/acepcion/1/ejemplo> ;
    skos:definition "Que tiene muchos colores vivos y mal combinados."@es .

<http://example.org/modcol/recurso/modismo/colorinche/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "La mayoría trae encima sacos de sudaderas con rayas de colorinches en los costados."@es .

<http://example.org/modcol/recurso/modismo/combinada/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/combinada/acepcion/1/ejemplo> ;
