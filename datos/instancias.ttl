    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balsámica/acepcion/1/ejemplo> ;
    skos:definition "Aguardiente casero hecho hecho con caña de azúcar sin refinar."@es .

<http://example.org/modcol/recurso/modismo/balsámica/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Una buena botella de biche o balsámica, bebida de caña con yerbas mágicas que revitalizan el espíritu."@es .

<http://example.org/modcol/recurso/modismo/balurdo/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/balurdo/acepcion/1/ejemplo> ;
