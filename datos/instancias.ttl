    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    skos:definition "Boca y labios grandes y gruesos."@es .

<http://example.org/modcol/recurso/modismo/boleta/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
    skos:definition "ostentoso, indiscreto"@es .

<http://example.org/modcol/recurso/modismo/boleta/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/boleta/acepcion/2/ejemplo> ;
    skos:definition "Referido a una persona u objeto, ordinario o de apariencia desagradable."@es .

<http://example.org/modcol/recurso/modismo/boleta/acepcion/2/ejemplo> a mc:EjemploDeUso ;
