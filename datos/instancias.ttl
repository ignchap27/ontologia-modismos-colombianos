<http://example.org/modcol/recurso/modismo/lampareado/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Cuando despertó se dio cuenta que estaba a orillas del río, bajo una mata de espinas y se encontraba lampareado de estiércol de vaca."@es .

<http://example.org/modcol/recurso/modismo/lamparón/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
    mc:tieneEjemplo <http://example.org/modcol/recurso/modismo/lamparón/acepcion/1/ejemplo> ;
