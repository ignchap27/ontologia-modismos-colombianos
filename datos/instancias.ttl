<http://example.org/modcol/recurso/modismo/paja/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "En Sandoná, occidente de Nariño, la elaboración de los sombreros de paja toquilla o iraca se constituye en una tradición centenaria."@es .

<http://example.org/modcol/recurso/modismo/paja/acepcion/2> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/bdc> ;
