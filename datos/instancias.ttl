<http://example.org/modcol/recurso/modismo/charrasquear/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "El guitarrillo es ideal para comenzar a charrasquear y acompañar las rondas infantiles."@es .

<http://example.org/modcol/recurso/modismo/charrera/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
