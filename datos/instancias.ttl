<http://example.org/modcol/recurso/modismo/encrespador/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Intenta apoyar la base del encrespador debajo del hueso de tu pómulo, tratando de siempre mantenerlo derecho."@es .

<http://example.org/modcol/recurso/modismo/encuartelar/acepcion/1> a mc:Acepcion ;
