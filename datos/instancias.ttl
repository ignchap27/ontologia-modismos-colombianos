<http://example.org/modcol/recurso/modismo/patorica/acepcion/1/ejemplo> a mc:EjemploDeUso ;
    mc:textoEjemplo "Algunos terminan inválidos o envejecen antes de tiempo por no usar su naturales patoricas y respirar permanentemente aire contaminado."@es .

<http://example.org/modcol/recurso/modismo/patota/acepcion/1> a mc:Acepcion ;
    mc:fuente <http://example.org/modcol/recurso/diccionario/dicol> ;
