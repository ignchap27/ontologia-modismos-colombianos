owl:Class owl:sameAs owl:Class .

owl:Nothing a owl:Class ;
    rdfs:subClassOf mc:Acepcion,
        mc:Ciudad,
        mc:Departamento,
        mc:Diccionario,
        mc:EjemploDeUso,
        mc:Locucion,
        mc:Lugar,
        mc:MacroRegion,
        mc:Modismo,
        mc:ModismoUnipalabra,
        mc:RegionNatural,
        owl:Nothing,
        owl:Thing,
        ns1:LexicalEntry,
        ns1:LexicalSense,
        schema:AdministrativeArea,
        schema:City,
        schema:Place ;
    owl:equivalentClass owl:Nothing ;
    owl:sameAs owl:Nothing .

schema:City owl:sameAs schema:City .

mc:Acepcion rdfs:subClassOf mc:Acepcion,
        owl:Thing ;
    owl:equivalentClass mc:Acepcion ;
    owl:sameAs mc:Acepcion .

mc:Ciudad rdfs:subClassOf mc:Ciudad,
        owl:Thing,
        schema:Place ;
    owl:equivalentClass mc:Ciudad ;
    owl:sameAs mc:Ciudad .

mc:Departamento rdfs:subClassOf mc:Departamento,
        owl:Thing,
        schema:Place ;
    owl:equivalentClass mc:Departamento ;
    owl:sameAs mc:Departamento .

mc:Diccionario rdfs:subClassOf mc:Diccionario,
        owl:Thing ;
    owl:equivalentClass mc:Diccionario ;
    owl:sameAs mc:Diccionario .

mc:EjemploDeUso rdfs:subClassOf mc:EjemploDeUso,
        owl:Thing ;
    owl:equivalentClass mc:EjemploDeUso ;
    owl:sameAs mc:EjemploDeUso .

mc:Locucion rdfs:subClassOf mc:Locucion,
        owl:Thing,
        ns1:LexicalEntry ;
    owl:equivalentClass mc:Locucion ;
    owl:sameAs mc:Locucion .

mc:MacroRegion rdfs:subClassOf mc:MacroRegion,
        owl:Thing,
        schema:Place ;
    owl:equivalentClass mc:MacroRegion ;
    owl:sameAs mc:MacroRegion .

mc:ModismoUnipalabra rdfs:subClassOf mc:ModismoUnipalabra,
        owl:Thing,
        ns1:LexicalEntry ;
    owl:equivalentClass mc:ModismoUnipalabra ;
    owl:sameAs mc:ModismoUnipalabra .

mc:RegionNatural rdfs:subClassOf mc:RegionNatural,
        owl:Thing,
        schema:Place ;
    owl:equivalentClass mc:RegionNatural ;
    owl:sameAs mc:RegionNatural .

